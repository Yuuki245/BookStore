@page
@model EmailModel
@{
    ViewData["Title"] = "Quản lý Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="manage-page-header mb-4">
    <h3 class="fw-bold mb-2">
        <i class="bi bi-envelope me-2 text-primary"></i>@ViewData["Title"]
    </h3>
    <p class="text-muted mb-0">Thay đổi email đăng nhập của bạn</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            
            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-semibold">
                    <i class="bi bi-envelope-at me-2 text-primary"></i>Email hiện tại
                </label>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="input-group">
                        <input asp-for="Email" 
                               class="form-control form-control-lg" 
                               placeholder="Email hiện tại" 
                               disabled />
                        <span class="input-group-text bg-success text-white">
                            <i class="bi bi-check-circle-fill"></i> Đã xác thực
                        </span>
                    </div>
                }
                else
                {
                    <div class="input-group">
                        <input asp-for="Email" 
                               class="form-control form-control-lg" 
                               placeholder="Email hiện tại" 
                               disabled />
                        <button id="email-verification" 
                                type="submit" 
                                asp-page-handler="SendVerificationEmail" 
                                class="btn btn-outline-warning">
                            <i class="bi bi-send me-1"></i>Gửi email xác thực
                        </button>
                    </div>
                    <div class="form-text text-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i>Email chưa được xác thực
                    </div>
                }
            </div>

            <div class="mb-4">
                <label asp-for="Input.NewEmail" class="form-label fw-semibold">
                    <i class="bi bi-envelope-plus me-2 text-primary"></i>Email mới
                </label>
                <input asp-for="Input.NewEmail" 
                       class="form-control form-control-lg" 
                       autocomplete="email" 
                       aria-required="true" 
                       placeholder="name@example.com" />
                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary btn-lg">
                <i class="bi bi-check-circle me-2"></i>Đổi email
            </button>
        </form>
    </div>
</div>

<style>
    .manage-page-header {
        border-bottom: 2px solid var(--bg-secondary);
        padding-bottom: 1rem;
    }

    .form-control-lg {
        padding: 0.75rem 1rem;
        border-radius: var(--radius-sm);
        border: 1px solid #e5e7eb;
        transition: all var(--transition-fast);
    }

    .form-control-lg:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 0.2rem rgba(59, 97, 235, 0.1);
    }

    .form-control-lg:disabled {
        background-color: var(--bg-secondary);
        opacity: 0.7;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}