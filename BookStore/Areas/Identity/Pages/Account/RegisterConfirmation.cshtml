@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đăng ký";
}

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card card glass-card card-lift text-center">
                    <div class="card-body p-4 p-md-5">
                        <div class="auth-icon mb-4">
                            <i class="bi bi-envelope-paper text-primary" style="font-size: 3.5rem;"></i>
                        </div>
                        <h2 class="fw-bold mb-3">Xác nhận tài khoản</h2>
                        @{
                            if (@Model.DisplayConfirmAccountLink)
                            {
                                <p class="text-muted mb-4">
                                    Vui lòng xác nhận tài khoản của bạn bằng cách nhấp vào link bên dưới.
                                </p>
                                <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-primary btn-lg w-100 mb-3">
                                    <i class="bi bi-check-circle me-2"></i>Xác nhận tài khoản
                                </a>
                            }
                            else
                            {
                                <p class="text-muted mb-4">
                                    Vui lòng kiểm tra email của bạn để xác nhận tài khoản. Chúng tôi đã gửi link xác nhận đến địa chỉ email bạn đã đăng ký.
                                </p>
                            }
                        }
                        <a asp-page="./Login" class="btn btn-outline-primary btn-lg w-100">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .auth-card {
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .auth-icon {
        display: inline-block;
        padding: 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .auth-icon i {
        color: white !important;
        font-size: 2.5rem !important;
    }
</style>

