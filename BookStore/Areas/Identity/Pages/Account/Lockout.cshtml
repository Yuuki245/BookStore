@page
@model LockoutModel
@{
    ViewData["Title"] = "Tài khoản bị khóa";
}

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card card glass-card card-lift text-center">
                    <div class="card-body p-4 p-md-5">
                        <div class="auth-icon mb-4" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
                            <i class="bi bi-lock-fill text-white" style="font-size: 3.5rem;"></i>
                        </div>
                        <h2 class="fw-bold mb-3 text-danger">Tài khoản bị khóa</h2>
                        <p class="text-muted mb-4">
                            Tài khoản của bạn đã bị khóa do quá nhiều lần đăng nhập sai. Vui lòng thử lại sau hoặc liên hệ quản trị viên để được hỗ trợ.
                        </p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .auth-card {
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .auth-icon {
        display: inline-block;
        padding: 1rem;
        border-radius: 50%;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .auth-icon i {
        color: white !important;
        font-size: 2.5rem !important;
    }
</style>
