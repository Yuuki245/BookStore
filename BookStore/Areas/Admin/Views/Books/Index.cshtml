@model IEnumerable<BookStore.Models.Book>
@{
    ViewData["Title"] = "Quản lý Sách";
    string q = ViewBag.Q ?? "";
    string sort = ViewBag.Sort ?? "new";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<h2 class="mb-3">Quản lý Sách</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm tiêu đề / tác giả" />
    </div>

    <!-- 🔸 Dropdown chọn thể loại -->
    <div class="col-auto">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả thể loại --</option>
            @foreach (var c in ViewBag.Categories)
            {
                <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">
                    @c.Name
                </option>
            }
        </select>
    </div>

    <!-- 🔸 Dropdown sắp xếp -->
    <div class="col-auto">
        <select name="sort" class="form-select" onchange="this.form.submit()">
            <option value="new" selected="@(ViewBag.Sort=="new")">Mới nhất</option>
            <option value="title_asc" selected="@(ViewBag.Sort=="title_asc")">A → Z</option>
            <option value="title_desc" selected="@(ViewBag.Sort=="title_desc")">Z → A</option>
            <option value="price_asc" selected="@(ViewBag.Sort=="price_asc")">Giá ↑</option>
            <option value="price_desc" selected="@(ViewBag.Sort=="price_desc")">Giá ↓</option>
        </select>
    </div>

    <div class="col-auto">
        <button class="btn btn-primary">Lọc</button>
    </div>

    <div class="col-auto">
        <a asp-action="Create" class="btn btn-success">+ Thêm mới</a>
    </div>
</form>


<table class="table table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Ảnh</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Giá</th>
            <th>Tồn kho</th>
            <th class="text-end">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td><img src="@(b.CoverUrl ?? "/images/no-cover.png")" style="width:56px;height:75px;object-fit:cover;border-radius:6px" /></td>
                <td>@b.Title</td>
                <td>@b.Author</td>
                <td>@b.Category?.Name</td>
                <td>@($"{b.Price:N0} ₫")</td>
                <td>@b.Stock</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Xoá sách @b.Title?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">Xoá</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i==page?"active":"")">
                    <a class="page-link" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
