@using System.Linq
@model IEnumerable<BookStore.Models.Book>
@{
    ViewData["Title"] = "Quản lý Sách";
    string q = ViewBag.Q ?? "";
    string sort = ViewBag.Sort ?? "new";
    int currentPage = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int? categoryId = ViewBag.CategoryId is int cid
        ? cid
        : ViewBag.CategoryId as int?;
    int totalBooks = Model.Count();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Quản lý Sách</h2>
        <p class="text-muted mb-0 small">@totalBooks mục hiển thị · Trang @currentPage/@totalPages</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Thêm sách
        </a>
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-diagram-3 me-1"></i>Quản lý thể loại
        </a>
    </div>
</div>

<!-- Form tìm kiếm và filter -->
<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small">Tìm kiếm</label>
                <input name="q" value="@q" class="form-control" placeholder="Tìm tiêu đề / tác giả" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Thể loại</label>
                <select name="categoryId" class="form-select">
                    <option value="">Tất cả thể loại</option>
                    @foreach (var c in ViewBag.Categories)
                    {
                        <option value="@c.Id" selected="@(categoryId == c.Id ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Sắp xếp</label>
                <select name="sort" class="form-select">
                    <option value="new" selected="@(sort == "new" ? "selected" : null)">Mới nhất</option>
                    <option value="title_asc" selected="@(sort == "title_asc" ? "selected" : null)">A → Z</option>
                    <option value="title_desc" selected="@(sort == "title_desc" ? "selected" : null)">Z → A</option>
                    <option value="price_asc" selected="@(sort == "price_asc" ? "selected" : null)">Giá tăng</option>
                    <option value="price_desc" selected="@(sort == "price_desc" ? "selected" : null)">Giá giảm</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-search me-1"></i>Lọc
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(q) || categoryId.HasValue)
        {
            <div class="mt-3">
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                </a>
            </div>
        }
    </div>
</form>

<!-- Danh sách sách -->
<div class="card card-lift shadow-sm">
    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Tác giả</th>
                    <th>Thể loại</th>
                    <th class="text-end" style="white-space: nowrap; min-width: 120px;">Giá</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-end table-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="bi bi-book-x fs-1 text-muted mb-3 d-block"></i>
                            <p class="text-muted mb-0">Không tìm thấy sách nào</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in Model)
                    {
                        var stockClass = b.Stock > 10 ? "badge-soft-success" : "badge-soft-warning";
                        <tr>
                            <td>
                                <img src="@(b.CoverUrl ?? "/images/no-cover.png")"
                                     alt="@b.Title"
                                     class="rounded"
                                     style="width: 60px; height: 80px; object-fit: cover;">
                            </td>
                            <td>
                                <div class="fw-semibold">@b.Title</div>
                                @if (b.OriginalPrice.HasValue && b.OriginalPrice > b.Price)
                                {
                                    <div class="text-muted small text-decoration-line-through">@($"{b.OriginalPrice:N0} ₫")</div>
                                }
                            </td>
                            <td class="text-muted">@b.Author</td>
                            <td>
                                @if (b.Category != null)
                                {
                                    <span class="badge bg-light text-dark">@b.Category.Name</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Chưa gán</span>
                                }
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <div class="fw-bold text-primary">@($"{b.Price:N0} ₫")</div>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-soft @stockClass">@b.Stock</span>
                            </td>
                            <td class="text-end table-actions">
                                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Xoá sách @b.Title?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Xoá
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i==currentPage ? "active" : "")">
                    <a class="page-link" asp-route-q="@q" asp-route-sort="@sort" asp-route-page="@i"
                       asp-route-categoryId="@categoryId">@i</a>
                </li>
            }
        </ul>
    </nav>
}
