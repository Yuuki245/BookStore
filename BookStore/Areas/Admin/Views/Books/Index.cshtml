@model IEnumerable<BookStore.Models.Book>
@{
    ViewData["Title"] = "Books";
}
@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@msg</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Tìm theo tiêu đề/tác giả..." style="min-width:280px" />
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm sách</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tiêu đề</th>
                    <th>Tác giả</th>
                    <th>Thể loại</th>
                    <th>Giá</th>
                    <th>Tồn</th>
                    <th class="text-end" style="width:170px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Title</td>
                        <td>@b.Author</td>
                        <td>@b.Category?.Name</td>
                        <td>@b.Price.ToString("N0") ₫</td>
                        <td>
                            @if (b.Stock <= 3)
                            {
                                <span class="badge text-bg-danger">Low: @b.Stock</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">@b.Stock</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#del-@b.Id">
                                <i class="bi bi-trash"></i>
                            </button>

                            <!-- Modal delete -->
                            <div class="modal fade" id="del-@b.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Xoá sách</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            Bạn chắc muốn xoá <strong>@b.Title</strong>?
                                        </div>
                                        <div class="modal-footer">
                                            <button class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button>
                                            <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-danger">Xoá</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
