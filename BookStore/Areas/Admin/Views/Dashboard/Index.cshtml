@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted">Tổng đơn</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalOrders</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted">Tổng doanh thu</div>
            <div class="fs-3 fw-bold text-success">@(((decimal)ViewBag.Revenue).ToString("N0")) ₫</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted">Tổng sách</div>
            <div class="fs-3 fw-bold">@ViewBag.TotalBooks</div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title m-0">Doanh thu</h5>
            <div class="btn-group" role="group" aria-label="Revenue range">
                <button type="button" class="btn btn-outline-primary btn-sm active" data-range="day">Ngày</button>
                <button type="button" class="btn btn-outline-primary btn-sm" data-range="week">Tuần</button>
                <button type="button" class="btn btn-outline-primary btn-sm" data-range="month">Tháng</button>
            </div>
        </div>
        <canvas id="revChart" height="120"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const ctx = document.getElementById('revChart');
          const btns = document.querySelectorAll('[data-range]');
          let chart;

          function initChart(labels, values){
            if(chart) chart.destroy();
            chart = new Chart(ctx, {
              type: 'bar',
              data: { labels, datasets: [{
                label: 'Doanh thu (VNĐ)', data: values,
                backgroundColor: '#0d6efd88', borderColor: '#0d6efd', borderWidth: 1, borderRadius: 6
              }]},
              options: {
                responsive: true,
                plugins: {
                  legend: { display: false },
                  tooltip: { callbacks: { label: c => c.parsed.y.toLocaleString('vi-VN') + ' ₫' } }
                },
                scales: { y: { ticks: { callback: v => v.toLocaleString('vi-VN') + ' ₫' } } }
              }
            });
          }

          async function loadData(range){
            const res = await fetch(`/Admin/Dashboard/GetRevenue?range=${range}`);
            const { labels, values } = await res.json();
            initChart(labels, values);
          }

          btns.forEach(btn => btn.addEventListener('click', () => {
            btns.forEach(b=>b.classList.remove('active'));
            btn.classList.add('active');
            loadData(btn.dataset.range);
          }));

          loadData('day'); // mặc định
        });
    </script>

}
