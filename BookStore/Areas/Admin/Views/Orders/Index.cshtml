@model BookStore.Models.ViewModels.OrderAdminListVM
@{
    ViewData["Title"] = "Orders";
    var statuses = new[] { "Pending", "Confirmed", "Shipped", "Completed", "Canceled" };
}

<h2 class="mb-3">Orders</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả trạng thái --</option>
            @foreach (var st in statuses)
            {
                <option value="@st" selected="@(Model.Status == st)">@st</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="from" class="form-control" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" class="form-control" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Lọc</button>
    </div>
    <div class="col-auto">
        <a class="btn btn-success"
           asp-action="ExportCsv"
           asp-route-status="@Model.Status"
           asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">
            Export CSV
        </a>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ngày</th>
                    <th>Khách</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.UserEmail</td>
                        <td>@await Html.PartialAsync("_OrderStatusBadge", o.Status)</td>
                        <td class="text-end">@($"{o.TotalAmount:N0} ₫")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i==Model.Page?"active":"")">
                    <a class="page-link"
                       asp-route-status="@Model.Status"
                       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                       asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                       asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
