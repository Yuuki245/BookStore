@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Admin") · BookStore</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin.css" />
    <script src="https://cdn.tiny.cloud/1/jm9wxk3197ldj2uw6zi5krclkwhcxljroctyp3tak3vk3ixn/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
</head>
<body>
    <div class="admin-wrap d-flex">
        <!-- Sidebar -->
        <aside class="admin-sidebar border-end bg-white">
            <div class="p-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-book-half fs-4 text-primary"></i>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="text-decoration-none h5 m-0 text-dark">BookStore Admin</a>
            </div>
            <nav class="p-2">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="admin-link nav-link"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                   class="admin-link nav-link"><i class="bi bi-tags me-2"></i>Categories</a>
                <a asp-area="Admin" asp-controller="Books" asp-action="Index"
                   class="admin-link nav-link"><i class="bi bi-journal-text me-2"></i>Books</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                   class="admin-link nav-link"><i class="bi bi-receipt me-2"></i>Orders</a>
                <a asp-area="Admin" asp-controller="Blog" asp-action="Index"
                   class="admin-link nav-link"><i class="bi bi-pencil-square me-2"></i>Blog</a>
                <hr />
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="admin-link nav-link"><i class="bi bi-arrow-left-circle me-2"></i>Back to Store</a>
            </nav>
        </aside>

        <!-- Main -->
        <div class="admin-main flex-grow-1">
            <header class="admin-header border-bottom bg-white d-flex align-items-center justify-content-between px-3">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="btnToggleSidebar"><i class="bi bi-list"></i></button>
                    <div class="fs-5 fw-semibold">@ViewData["Title"]</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</span>
                    <form method="post" asp-area="" asp-page="/Account/Logout" class="m-0">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </form>
                </div>
            </header>

            <main class="admin-content container-fluid py-3">
                @await Html.PartialAsync("~/Views/Shared/_Toast.cshtml")
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Active link
        (function(){
          const path = location.pathname.toLowerCase();
          document.querySelectorAll('.admin-link').forEach(a=>{
            if (a.getAttribute('href') && path.startsWith(a.getAttribute('href').toLowerCase())) {
              a.classList.add('active');
            }
          });
          // Toggle sidebar (mobile)
          const btn = document.getElementById('btnToggleSidebar');
          if (btn) btn.addEventListener('click', () => document.body.classList.toggle('sidebar-open'));
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
