@{
    var ok = TempData["Success"] as string;
    var warn = TempData["Warning"] as string;
    var err = TempData["Error"] as string;
}
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    @if (!string.IsNullOrEmpty(ok))
    {
        <div class="toast align-items-center text-bg-success border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@ok</div>
                <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(warn))
    {
        <div class="toast align-items-center text-bg-warning border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-exclamation-triangle me-2"></i>@warn</div>
                <button type="button" class="btn-close m-auto me-2" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(err))
    {
        <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-x-circle me-2"></i>@err</div>
                <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>
