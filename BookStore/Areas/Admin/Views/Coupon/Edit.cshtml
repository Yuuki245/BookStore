@model BookStore.Models.Coupon
@{
    ViewData["Title"] = "Chỉnh sửa Mã giảm giá";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Chỉnh sửa Mã giảm giá</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Code" class="form-label fw-semibold">Mã giảm giá *</label>
                    <input asp-for="Code" class="form-control" placeholder="Ví dụ: SALE2024" style="text-transform: uppercase;" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                    <div class="form-text">Mã sẽ được chuyển thành chữ hoa</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DiscountType" class="form-label fw-semibold">Loại giảm giá *</label>
                    <select asp-for="DiscountType" class="form-select">
                        <option value="Percentage">Phần trăm (%)</option>
                        <option value="FixedAmount">Số tiền cố định (₫)</option>
                    </select>
                    <span asp-validation-for="DiscountType" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DiscountValue" class="form-label fw-semibold">Giá trị giảm *</label>
                    <input asp-for="DiscountValue" class="form-control" type="number" min="0" step="0.01" />
                    <span asp-validation-for="DiscountValue" class="text-danger"></span>
                    <div class="form-text" id="discountHint">Nhập phần trăm (0-100) hoặc số tiền</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="MaxDiscount" class="form-label fw-semibold">Giảm giá tối đa (₫)</label>
                    <input asp-for="MaxDiscount" class="form-control" type="number" min="0" step="0.01" />
                    <span asp-validation-for="MaxDiscount" class="text-danger"></span>
                    <div class="form-text">Chỉ áp dụng cho loại Phần trăm. Để trống nếu không giới hạn.</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MinOrderAmount" class="form-label fw-semibold">Đơn hàng tối thiểu (₫)</label>
                    <input asp-for="MinOrderAmount" class="form-control" type="number" min="0" step="0.01" />
                    <span asp-validation-for="MinOrderAmount" class="text-danger"></span>
                    <div class="form-text">Để trống nếu không yêu cầu đơn hàng tối thiểu</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="UsageLimit" class="form-label fw-semibold">Giới hạn số lần sử dụng</label>
                    <input asp-for="UsageLimit" class="form-control" type="number" min="1" />
                    <span asp-validation-for="UsageLimit" class="text-danger"></span>
                    <div class="form-text">Tổng số lần tất cả user có thể sử dụng. Để trống nếu không giới hạn. Đã sử dụng: <strong>@Model.UsedCount</strong> lần</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxUsagePerUser" class="form-label fw-semibold">Số lần sử dụng tối đa mỗi user</label>
                    <input asp-for="MaxUsagePerUser" class="form-control" type="number" min="1" />
                    <span asp-validation-for="MaxUsagePerUser" class="text-danger"></span>
                    <div class="form-text">Mỗi user chỉ được sử dụng mã này tối đa bao nhiêu lần. Để trống nếu không giới hạn.</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label fw-semibold">Ngày bắt đầu *</label>
                    <input asp-for="StartDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label fw-semibold">Ngày kết thúc *</label>
                    <input asp-for="EndDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả về mã giảm giá..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Kích hoạt mã giảm giá</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Hủy
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const discountType = document.getElementById('DiscountType');
            const discountValue = document.getElementById('DiscountValue');
            const maxDiscount = document.getElementById('MaxDiscount');
            const discountHint = document.getElementById('discountHint');

            function updateHint() {
                if (discountType.value === 'Percentage') {
                    discountHint.textContent = 'Nhập phần trăm giảm giá (0-100)';
                    maxDiscount.closest('.mb-3').style.display = 'block';
                } else {
                    discountHint.textContent = 'Nhập số tiền giảm giá (VNĐ)';
                    maxDiscount.closest('.mb-3').style.display = 'none';
                }
            }

            discountType.addEventListener('change', updateHint);
            updateHint();
        });
    </script>
}

