@model IEnumerable<BookStore.Models.Category>
@{
    ViewData["Title"] = "Categories";
}
<h2>Categories</h2>
<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table table-striped align-middle">
    <thead><tr><th>Name</th><th>Description</th><th style="width:160px;"></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Description</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
