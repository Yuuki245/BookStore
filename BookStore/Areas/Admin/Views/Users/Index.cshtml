@model List<BookStore.Models.ViewModels.UserVM>
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ Admin</a></li>
        <li class="breadcrumb-item active" aria-current="page">Quản lý Người dùng</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-2">
            <i class="bi bi-people-fill me-2 text-primary"></i>@ViewData["Title"]
        </h2>
        <p class="text-muted mb-0">Quản lý tài khoản người dùng và phân quyền trong hệ thống</p>
    </div>
    <div class="text-muted">
        <i class="bi bi-person-check me-1"></i>
        <strong>Tổng số:</strong> @Model.Count người dùng
    </div>
</div>

<!-- Users Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom">
        <h5 class="mb-0">
            <i class="bi bi-table me-2"></i>Danh sách người dùng
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">
                            <i class="bi bi-envelope me-2"></i>Email / Tên đăng nhập
                        </th>
                        <th>
                            <i class="bi bi-shield-check me-2"></i>Quyền (Roles)
                        </th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr class="user-row">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="user-avatar me-3">
                                            <i class="bi bi-person-circle fs-4 text-muted"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@user.Email</div>
                                            <small class="text-muted">ID: @user.UserId.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                var (iconClass, badgeClass, roleDisplay) = role switch
                                                {
                                                    "Admin" => ("bi-shield-fill", "role-badge-admin", "Admin"),
                                                    "Customer" => ("bi-person-fill", "role-badge-customer", "Customer"),
                                                    _ => ("bi-person-badge", "role-badge-other", role)
                                                };
                                                
                                                <span class="badge role-badge-enhanced @badgeClass">
                                                    <i class="bi @iconClass me-1"></i>@roleDisplay
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge role-badge-no-role">
                                                <i class="bi bi-x-circle me-1"></i>Không có quyền
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="ManageRoles" 
                                       asp-route-id="@user.UserId" 
                                       class="btn btn-sm btn-outline-primary btn-manage-role">
                                        <i class="bi bi-pencil-square me-1"></i>Quản lý Quyền
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                <p class="text-muted mt-3 mb-0">Chưa có người dùng nào trong hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .user-row {
        transition: background-color 0.2s ease;
    }

    .user-row:hover {
        background-color: #f8f9fa;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f0f0;
        border-radius: 50%;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 1.5rem;
    }

    .breadcrumb-item a {
        color: var(--brand);
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: var(--muted);
    }

    .btn-manage-role {
        transition: all 0.3s ease;
    }

    .btn-manage-role:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
    }
</style>