@model BookStore.Models.ViewModels.ManageRolesVM
@{
    ViewData["Title"] = "Quản lý Quyền";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang chủ Admin</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Người dùng</a></li>
        <li class="breadcrumb-item active" aria-current="page">Quản lý Quyền</li>
    </ol>
</nav>

<!-- Header Section -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-2">
            <i class="bi bi-shield-check me-2 text-primary"></i>@ViewData["Title"]
        </h2>
        <p class="text-muted mb-0">
            <i class="bi bi-person-circle me-1"></i>
            <strong>Tài khoản:</strong> <span class="text-dark">@Model.Email</span>
        </p>
    </div>
</div>

<form method="post" id="manageRolesForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <!-- Roles Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-check me-2"></i>Danh sách quyền
            </h5>
        </div>
        <div class="card-body p-4">
            @if (Model.Roles.Any())
            {
                <div class="row g-3">
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <input type="hidden" asp-for="Roles[i].Name" />
                        
                        var role = Model.Roles[i];
                        var roleName = role.Name;
                        var (iconClass, badgeClass, description) = roleName switch
                        {
                            "Admin" => ("bi-shield-fill", "role-admin", "Quyền quản trị viên - Toàn quyền truy cập hệ thống"),
                            "Customer" => ("bi-person-fill", "role-customer", "Quyền khách hàng - Mua sắm và quản lý đơn hàng"),
                            _ => ("bi-person-badge", "role-other", "Quyền người dùng")
                        };
                        
                        <div class="col-md-6 col-lg-4">
                            <div class="role-card @(role.IsSelected ? "role-card-selected" : "")">
                                <div class="form-check role-checkbox-wrapper">
                                    <input asp-for="Roles[i].IsSelected" 
                                           class="form-check-input role-checkbox" 
                                           type="checkbox"
                                           id="role_@i" />
                                    <label class="form-check-label role-label" for="role_@i">
                                        <div class="d-flex align-items-center">
                                            <div class="role-icon-wrapper @badgeClass">
                                                <i class="bi @iconClass"></i>
                                            </div>
                                            <div class="ms-3 flex-grow-1">
                                                <div class="role-name fw-bold">@roleName</div>
                                                <div class="role-description small text-muted">@description</div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-3">Chưa có quyền nào trong hệ thống.</p>
                </div>
            }
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-3 justify-content-end">
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-check-circle me-2"></i>Lưu thay đổi
        </button>
    </div>
</form>

<style>
    .role-card {
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.25rem;
        transition: all 0.3s ease;
        background: #fff;
        cursor: pointer;
    }

    .role-card:hover {
        border-color: var(--brand);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
        transform: translateY(-2px);
    }

    .role-card-selected {
        border-color: var(--brand);
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
    }

    .role-checkbox-wrapper {
        margin: 0;
        cursor: pointer;
    }

    .role-checkbox {
        width: 1.25rem;
        height: 1.25rem;
        margin-top: 0.25rem;
        cursor: pointer;
    }

    .role-label {
        cursor: pointer;
        width: 100%;
        margin: 0;
    }

    .role-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .role-admin {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
    }

    .role-customer {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
    }

    .role-other {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3);
    }

    .role-card-selected .role-icon-wrapper {
        transform: scale(1.1);
    }

    .role-name {
        font-size: 1.1rem;
        color: #1f2937;
        margin-bottom: 0.25rem;
    }

    .role-description {
        font-size: 0.875rem;
        line-height: 1.4;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 1.5rem;
    }

    .breadcrumb-item a {
        color: var(--brand);
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: var(--muted);
    }

    @@media (max-width: 767.98px) {
        .role-card {
            padding: 1rem;
        }

        .role-icon-wrapper {
            width: 40px;
            height: 40px;
            font-size: 1.25rem;
        }

        .role-name {
            font-size: 1rem;
        }

        .role-description {
            font-size: 0.8rem;
        }

        .d-flex.gap-3 {
            flex-direction: column;
        }

        .d-flex.gap-3 .btn {
            width: 100%;
        }
    }
</style>