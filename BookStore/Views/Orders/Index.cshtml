@model IEnumerable<BookStore.Models.ViewModels.OrderListItemVM>
@{
    ViewData["Title"] = "My Orders";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<h2>My Orders</h2>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ngày</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var badge = o.Status switch
                    {
                        "Pending" => "secondary",
                        "Confirmed" => "primary",
                        "Shipped" => "info",
                        "Completed" => "success",
                        "Canceled" => "danger",
                        _ => "secondary"
                    };
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge text-bg-@badge">@o.Status</span></td>
                        <td class="text-end">@o.TotalAmount.ToString("N0") ₫</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i==page?"active":"")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
