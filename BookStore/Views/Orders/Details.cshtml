@model BookStore.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<h2>Order #@Model.Id</h2>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card p-3">
            <div class="fw-semibold mb-2">Sản phẩm</div>
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Sách</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td>@i.Book?.Title</td>
                            <td>@i.Quantity</td>
                            <td>@i.UnitPrice.ToString("N0") ₫</td>
                            <td>@((i.UnitPrice * i.Quantity).ToString("N0")) ₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-3">
            <div class="small text-muted">Ngày tạo</div>
            <div class="mb-2">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>

            <div class="small text-muted">Trạng thái</div>
            @{
                var cls = Model.Status switch
                {
                    "Pending" => "secondary",
                    "Confirmed" => "primary",
                    "Shipped" => "info",
                    "Completed" => "success",
                    "Canceled" => "danger",
                    _ => "secondary"
                };
            }
            <div class="mb-2"><span class="badge text-bg-@cls">@Model.Status</span></div>

            <div class="small text-muted">Giao đến</div>
            <div class="mb-2">@Model.ShippingAddress</div>

            <div class="small text-muted">Liên hệ</div>
            <div class="mb-3">@Model.PhoneNumber</div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="small text-muted">Tổng tiền:</div>
                <div class="fs-5 fw-bold text-end text-success">
                    @(Model.TotalAmount.ToString("N0")) ₫
                </div>

            </div>

            <hr />
            @if (Model.Status == "Completed")
            {
                <button id="printInvoiceBtn" class="btn btn-info w-100 mb-2">
                    <i class="bi bi-printer"></i> In Hóa Đơn (PDF)
                </button>
            }
            @if (Model.Status == "Pending")
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger w-100" onclick="return confirm('Hủy đơn này?')">Hủy đơn</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
             // Chỉ thêm sự kiện click nếu nút đó tồn tại
             const printButton = document.getElementById('printInvoiceBtn');
             if (printButton) {
                 printButton.addEventListener('click', function() {
                     window.print(); // Kích hoạt chức năng in của trình duyệt
                 });
             }
    </script>
}
