@model BookStore.Models.Order
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
    var subtotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
    var discountAmount = Model.DiscountAmount;
    var finalTotal = Model.TotalAmount;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-receipt-cutoff me-2"></i>Chi tiết đơn hàng #@Model.Id
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-cart-check me-2"></i>Sản phẩm đã đặt
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Sách</th>
                                    <th class="text-center" style="width: 100px;">Số lượng</th>
                                    <th class="text-end" style="width: 120px;">Đơn giá</th>
                                    <th class="text-end" style="width: 150px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                }
                                @foreach (var i in Model.Items)
                                {
                                    <tr>
                                        <td class="text-muted">@index</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(i.Book?.CoverUrl))
                                                {
                                                    <img src="@i.Book.CoverUrl" alt="@i.Book?.Title" 
                                                         class="me-2" style="width: 50px; height: 70px; object-fit: cover; border-radius: 4px;">
                                                }
                                                <div>
                                                    <div class="fw-semibold">@i.Book?.Title</div>
                                                    @if (i.Book != null)
                                                    {
                                                        <small class="text-muted">Mã sách: #@i.Book.Id</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@i.Quantity</td>
                                        <td class="text-end">@i.UnitPrice.ToString("N0") ₫</td>
                                        <td class="text-end fw-semibold">@((i.UnitPrice * i.Quantity).ToString("N0")) ₫</td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Thông tin đơn hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="small text-muted mb-1">
                            <i class="bi bi-calendar-event me-1"></i>Ngày tạo
                        </div>
                        <div class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">
                            <i class="bi bi-info-circle me-1"></i>Trạng thái
                        </div>
                        <div>
                            @await Html.PartialAsync("_OrderStatusBadge", Model.Status)
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">
                            <i class="bi bi-geo-alt me-1"></i>Địa chỉ giao hàng
                        </div>
                        <div class="fw-semibold">@Model.ShippingAddress</div>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">
                            <i class="bi bi-telephone me-1"></i>Số điện thoại
                        </div>
                        <div class="fw-semibold">@Model.PhoneNumber</div>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-semibold">@subtotal.ToString("N0") ₫</span>
                        </div>
                        
                        @if (discountAmount > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted">
                                    <i class="bi bi-tag me-1"></i>Giảm giá:
                                    @if (!string.IsNullOrEmpty(Model.CouponCode))
                                    {
                                        <span class="badge bg-success ms-1">@Model.CouponCode</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info ms-1">Tự động</span>
                                    }
                                </span>
                                <span class="fw-semibold text-success">- @discountAmount.ToString("N0") ₫</span>
                            </div>
                        }
                        
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Tổng cộng:</span>
                            <span class="fw-bold fs-4 text-success">@finalTotal.ToString("N0") ₫</span>
                        </div>
                    </div>

                    <hr />

                    @if (Model.Status == "Completed")
                    {
                        <button id="printInvoiceBtn" class="btn btn-info w-100 mb-2">
                            <i class="bi bi-printer me-1"></i>In Hóa Đơn
                        </button>
                    }
                    @if (Model.Status == "Pending" || Model.Status == "Confirmed")
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger w-100" onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                                <i class="bi bi-x-circle me-1"></i>Hủy đơn hàng
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Canceled")
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Đơn hàng đã bị hủy.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
             // Chỉ thêm sự kiện click nếu nút đó tồn tại
             const printButton = document.getElementById('printInvoiceBtn');
             if (printButton) {
                 printButton.addEventListener('click', function() {
                     window.print(); // Kích hoạt chức năng in của trình duyệt
                 });
             }
    </script>
}
