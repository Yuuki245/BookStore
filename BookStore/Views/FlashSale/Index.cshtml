@model IEnumerable<BookStore.Models.Book>
@using BookStore.Helpers
@{
    ViewData["Title"] = "Flash Sale";
    var flashSale = ViewBag.FlashSale as BookStore.Models.FlashSale;
}

@if (flashSale == null)
{
    <div class="container my-5">
        <div class="text-center py-5">
            <i class="bi bi-lightning-charge text-muted" style="font-size: 4rem;"></i>
            <h3 class="mt-3 mb-2">Không có Flash Sale</h3>
            <p class="text-muted mb-4">@ViewBag.Message</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left me-2"></i>Về trang chủ
            </a>
        </div>
    </div>
}
else
{
    <div class="container my-4">
        <!-- Flash Sale Header -->
        <div class="flash-sale-header card border-0 mb-4 fade-in" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); color: white;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="flash-sale-icon">
                                <i class="bi bi-lightning-charge-fill" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h2 class="fw-bold mb-1">@flashSale.Title</h2>
                                @if (!string.IsNullOrEmpty(flashSale.Description))
                                {
                                    <p class="mb-0 opacity-90">@flashSale.Description</p>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-4">
                            <div>
                                <div class="small opacity-75">Giảm giá</div>
                                <div class="h3 fw-bold mb-0">@flashSale.DiscountPercent%</div>
                            </div>
                            <div>
                                <div class="small opacity-75">Số sách</div>
                                <div class="h4 fw-bold mb-0">@Model.Count() sách</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <div class="mb-2">
                            <div class="small opacity-75 mb-2">Kết thúc trong</div>
                            <div id="flash-sale-countdown" class="countdown-display h3 fw-bold mb-3">
                                <span class="countdown-days">00</span>:
                                <span class="countdown-hours">00</span>:
                                <span class="countdown-minutes">00</span>:
                                <span class="countdown-seconds">00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Flash Sale Products -->
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted">Chưa có sản phẩm nào trong flash sale này.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var book in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="book" />
                    </div>
                }
            </div>
        }
    </div>

    <script>
        (function() {
            // Dùng thời gian UTC từ server, client tự chuyển múi giờ chính xác
            const endTime = new Date('@flashSale.EndTime.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss\\Z")');
            const countdownElement = document.getElementById('flash-sale-countdown');
            
            if (!countdownElement) return;

            function updateCountdown() {
                const now = new Date();
                const diff = endTime - now;

                if (diff <= 0) {
                    countdownElement.innerHTML = '<span class="text-warning">Đã kết thúc</span>';
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                countdownElement.querySelector('.countdown-days').textContent = String(days).padStart(2, '0');
                countdownElement.querySelector('.countdown-hours').textContent = String(hours).padStart(2, '0');
                countdownElement.querySelector('.countdown-minutes').textContent = String(minutes).padStart(2, '0');
                countdownElement.querySelector('.countdown-seconds').textContent = String(seconds).padStart(2, '0');
            }

            updateCountdown();
            setInterval(updateCountdown, 1000);
        })();
    </script>

    <style>
        .flash-sale-header {
            box-shadow: 0 10px 30px rgba(255, 107, 107, 0.3);
        }

        .flash-sale-icon {
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
        }

        .countdown-display {
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }
    </style>
}

