@* 🟢 1. SỬA: Đổi model thành BlogListVM *@
@model BookStore.Models.ViewModels.BlogListVM
@{
    ViewData["Title"] = "Blog";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row g-4">
    @if (!Model.Posts.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">Chưa có bài viết nào.</div>
        </div>
    }

    @* 🟢 3. SỬA: Lặp qua Model.Posts *@
    @foreach (var post in Model.Posts)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <a asp-action="Details" asp-route-id="@post.Id">
                    <img src="@(post.HeaderImageUrl ?? "https://via.placeholder.com/400x250/dee2e6/6c757d?text=Blog+Post")"
                         class="card-img-top" alt="@post.Title" style="height: 200px; object-fit: cover;">
                </a>

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@post.Title</h5>
                    <div class="text-muted small mb-2">
                        Đăng bởi @(post.User?.UserName ?? "Admin") vào @post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                    </div>

                    <p class="card-text text-truncate-3">
                        @(post.Excerpt ?? "Nhấn 'Đọc thêm' để xem chi tiết...")
                    </p>

                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-outline-primary">Đọc thêm</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}