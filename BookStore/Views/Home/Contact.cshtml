@{
    ViewData["Title"] = "Liên hệ";
}

<h1 class="display-5 fw-bold mb-3 text-center">@ViewData["Title"]</h1>
<p class="lead text-center mb-5">Chúng tôi luôn sẵn sàng lắng nghe bạn. Vui lòng liên hệ qua các thông tin dưới đây.</p>

<div class="row g-5">
    <div class="col-lg-6">
        <h3>Thông tin liên hệ</h3>
        <ul class="list-unstyled fs-5" style="line-height: 2.5;">
            <li>
                <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                Địa chỉ: 123 Đường Sách, Cầu Giấy, Hà Nội
            </li>
            <li>
                <i class="bi bi-telephone-fill text-primary me-2"></i>
                Hotline: 1900 0000
            </li>
            <li>
                <i class="bi bi-envelope-fill text-primary me-2"></i>
                Email: support@qktbook.local
            </li>
            <li>
                <i class="bi bi-clock-fill text-primary me-2"></i>
                Giờ mở cửa: 08:00 - 21:00 (Tất cả các ngày)
            </li>
        </ul>
    </div>

    <div class="col-lg-6">
        <h3>Tìm chúng tôi trên bản đồ</h3>
        <div class="ratio ratio-16x9 rounded-3 shadow-sm overflow-hidden">
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3662.2066541043355!2d105.87582719999999!3d20.9820313!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135afd765487289%3A0x21bd5839ba683d5f!2zVHLGsOG7nW5nIMSQ4bqhaSBI4buNYyBLaW5oIFThur8gS-G7uSBUaHXhuq10IEPDtG5nIE5naGnhu4dw!5e1!3m2!1svi!2s!4v1762845541128!5m2!1svi!2s" 
                style="border:0; width:100%; height:100%;" 
                allowfullscreen 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title="Bản đồ địa chỉ BookStore">
            </iframe>
        </div>
    </div>
</div>