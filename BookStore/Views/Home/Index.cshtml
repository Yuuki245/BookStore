@model BookStore.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Trang chủ";
}

@* Flash Sale Banner *@
@await Component.InvokeAsync("FlashSaleBanner")

@* Flash Sale Products Section *@
@if (Model?.ActiveFlashSale != null && Model.FlashSaleBooks?.Any() == true)
{
    <section class="my-3 fade-in section-divider">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h2 class="section-title mb-0">
                <i class="bi bi-lightning-charge-fill me-2 text-danger"></i>Flash Sale
            </h2>
            <a asp-controller="FlashSale" asp-action="Index" class="text-decoration-none fw-semibold text-primary">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.FlashSaleBooks)
                {
                    ViewData["TagType"] = "FlashSale";
                    <div>
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
            <button type="button" class="scroll-nav scroll-next" aria-label="Sách tiếp theo">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </section>
}

<section class="my-3 fade-in section-divider">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="section-title mb-0"><i class="bi bi-fire me-2 text-danger"></i>Sách bán chạy</h2>
        <a asp-controller="Books" asp-action="Index" class="text-decoration-none fw-semibold text-primary">
            Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (Model?.Bestsellers?.Any() == true)
    {
        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.Bestsellers)
                {
                    ViewData["TagType"] = "Bestseller";
                    <div>
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
            <button type="button" class="scroll-nav scroll-next" aria-label="Sách tiếp theo">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>

<section class="my-3 fade-in section-divider">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="section-title mb-0"><i class="bi bi-tag-fill me-2 text-success"></i>Giảm giá Hôm nay</h2>
    </div>

    @if (Model?.DailySales?.Any() == true)
    {
        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.DailySales)
                {
                    ViewData["TagType"] = "Sale";
                    <div>
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
            <button type="button" class="scroll-nav scroll-next" aria-label="Sách tiếp theo">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có sản phẩm nào được giảm giá.</div>
    }
</section>

<section class="my-3 fade-in section-divider">
    <div class="p-4 rounded-4" style="background: linear-gradient(135deg, #e6f1ff 0%, #dbe7ff 100%); border:1px solid #dbe7ff">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="fw-semibold">
                <i class="bi bi-gift-fill me-2 text-primary"></i>
                Người bán đang giảm giá! Tiết kiệm lớn cho lần mua sách tiếp theo của bạn.
            </div>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag-check me-2"></i>Mua ngay
            </a>
        </div>
    </div>
</section>

<section class="my-3 fade-in section-divider">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h2 class="section-title mb-0"><i class="bi bi-lightbulb-fill me-2 text-primary"></i>Đề xuất cho bạn</h2>
    </div>

    @if (Model?.NewReleases?.Any() == true)
    {
        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.NewReleases)
                {
                    ViewData["TagType"] = "Recommend";
                    <div>
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
            <button type="button" class="scroll-nav scroll-next" aria-label="Sách tiếp theo">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>

@section Scripts {
    <script>
        (function() {
            'use strict';
            
            // Debounce function để tối ưu resize event
            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.scroll-section').forEach(section => {
                    const scroller = section.querySelector('.scroll-x');
                    const prev = section.querySelector('.scroll-prev');
                    const next = section.querySelector('.scroll-next');
                    if (!scroller) return;

                    const updateDisabled = () => {
                        if (!prev || !next) return;
                        const maxScroll = scroller.scrollWidth - scroller.clientWidth - 2;
                        const isAtStart = scroller.scrollLeft <= 1;
                        const isAtEnd = scroller.scrollLeft >= maxScroll;
                        
                        prev.disabled = isAtStart;
                        next.disabled = isAtEnd;
                        
                        // Đảm bảo nút luôn hiển thị
                        prev.style.display = 'flex';
                        next.style.display = 'flex';
                    };

                    const scrollByAmount = dir => {
                        const amount = scroller.clientWidth * 0.8;
                        scroller.scrollBy({ left: dir * amount, behavior: 'smooth' });
                    };

                    prev?.addEventListener('click', () => scrollByAmount(-1), { passive: true });
                    next?.addEventListener('click', () => scrollByAmount(1), { passive: true });
                    scroller?.addEventListener('scroll', updateDisabled, { passive: true });
                    
                    // Sử dụng debounce cho resize để tối ưu performance
                    const debouncedUpdate = debounce(updateDisabled, 150);
                    window.addEventListener('resize', debouncedUpdate, { passive: true });
                    
                    // Initial update
                    updateDisabled();
                });
            });
        })();
    </script>
}