﻿@model BookStore.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="my-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="section-title mb-0">Sách bán chạy</h2>
        <a asp-controller="Books" asp-action="Index" class="text-decoration-none">Xem tất cả</a>
    </div>

    @if (Model?.Bestsellers?.Any() == true)
    {
        <div class="scroll-x">
            @foreach (var b in Model.Bestsellers)
            {
                ViewData["TagType"] = "Bestseller";
                <div>
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>
