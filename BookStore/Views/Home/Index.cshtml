@model BookStore.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Trang chủ";
}

@* Flash Sale Banner *@
@await Component.InvokeAsync("FlashSaleBanner")

@* Flash Sale Products Section *@
@if (Model?.ActiveFlashSale != null && Model.FlashSaleBooks?.Any() == true)
{
    <section class="home-section fade-in section-divider">
        <div class="section-header">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="section-title mb-0">
                    <span class="section-icon flash-sale-icon">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </span>
                    <span>Flash Sale</span>
                </h2>
                <a asp-controller="FlashSale" asp-action="Index" class="section-view-all">
                    Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.FlashSaleBooks)
                {
                    ViewData["TagType"] = "FlashSale";
                    <div class="book-card-wrapper">
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
            <button type="button" class="scroll-nav scroll-next" aria-label="Sách tiếp theo">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </section>
}

<section class="home-section fade-in section-divider">
    <div class="section-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">
                <span class="section-icon bestseller-icon">
                    <i class="bi bi-fire"></i>
                </span>
                <span>Sách bán chạy</span>
            </h2>
            <a asp-controller="Books" asp-action="Index" class="section-view-all">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    @if (Model?.Bestsellers?.Any() == true)
    {
        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.Bestsellers)
                {
                    ViewData["TagType"] = "Bestseller";
                    <div class="book-card-wrapper">
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
            <button type="button" class="scroll-nav scroll-next" aria-label="Sách tiếp theo">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
    else
    {
        <div class="empty-section-message">
            <i class="bi bi-inbox me-2"></i>Chưa có dữ liệu.
        </div>
    }
</section>

<section class="home-section fade-in section-divider">
    <div class="section-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">
                <span class="section-icon sale-icon">
                    <i class="bi bi-tag-fill"></i>
                </span>
                <span>Giảm giá Hôm nay</span>
            </h2>
        </div>
    </div>

    @if (Model?.DailySales?.Any() == true)
    {
        <div class="scroll-section">
            <button type="button" class="scroll-nav scroll-prev" aria-label="Sách trước">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="scroll-x">
                @foreach (var b in Model.DailySales)
                {
                    ViewData["TagType"] = "Sale";
