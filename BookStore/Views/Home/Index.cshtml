@model BookStore.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Home";
}

<!-- Today’s bestsellers -->
<section class="my-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="section-title mb-0">Today's bestsellers</h2>
        <a asp-controller="Books" asp-action="Index" class="text-decoration-none">See all</a>
    </div>

    @if (Model?.Bestsellers?.Any() == true)
    {
        <div class="scroll-x">
            @foreach (var b in Model.Bestsellers)
            {
                <div>
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>

<!-- Promo strip -->
<section class="my-4">
    <div class="p-3 rounded-4" style="background:#e6f1ff; border:1px solid #dbe7ff">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="fw-semibold">PangoBooks sellers having sales! Save big on your next book haul.</div>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-sm">Shop now</a>
        </div>
    </div>
</section>

<!-- New releases -->
<section class="my-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="section-title mb-0">New releases available on PangoBooks</h2>
    </div>

    @if (Model?.NewReleases?.Any() == true)
    {
        <div class="scroll-x">
            @foreach (var b in Model.NewReleases)
            {
                <div>
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>
