@model BookStore.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="my-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0"><i class="bi bi-fire me-2 text-danger"></i>Sách bán chạy</h2>
        <a asp-controller="Books" asp-action="Index" class="text-decoration-none fw-semibold">
            Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (Model?.Bestsellers?.Any() == true)
    {
        <div class="scroll-x">
            @foreach (var b in Model.Bestsellers)
            {
                ViewData["TagType"] = "Bestseller";
                <div>
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>

<section class="my-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0"><i class="bi bi-tag-fill me-2 text-success"></i>Giảm giá Hôm nay</h2>
    </div>

    @if (Model?.DailySales?.Any() == true)
    {
        <div class="scroll-x">
            @foreach (var b in Model.DailySales)
            {
                ViewData["TagType"] = "Sale";
                <div>
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có sản phẩm nào được giảm giá.</div>
    }
</section>

<section class="my-4 fade-in">
    <div class="p-4 rounded-4" style="background: linear-gradient(135deg, #e6f1ff 0%, #dbe7ff 100%); border:1px solid #dbe7ff">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="fw-semibold">
                <i class="bi bi-gift-fill me-2 text-primary"></i>
                Người bán đang giảm giá! Tiết kiệm lớn cho lần mua sách tiếp theo của bạn.
            </div>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag-check me-2"></i>Mua ngay
            </a>
        </div>
    </div>
</section>

<section class="my-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title mb-0"><i class="bi bi-star-fill me-2 text-warning"></i>Sách mới phát hành</h2>
    </div>

    @if (Model?.NewReleases?.Any() == true)
    {
        <div class="scroll-x">
            @foreach (var b in Model.NewReleases)
            {
                ViewData["TagType"] = "New";
                <div>
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">Chưa có dữ liệu.</div>
    }
</section>