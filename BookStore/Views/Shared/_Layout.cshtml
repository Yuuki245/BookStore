@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BookStore</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <style>
        .logo-font {
            /* Dùng font 'Merriweather' mới, nếu không có thì dùng font serif mặc định */
            font-family: 'Merriweather', serif;
            font-weight: 700;
            font-size: 1.1rem; /* Hơi to hơn một chút */
        }

        @@media print {
            /* Ẩn Header, Footer, và Mega Menu */
            body > header,
            body > footer,
            #megaMenu {
                display: none !important;
            }
            /* Ẩn các nút bấm trên trang Details */
            #printInvoiceBtn,
            #cancelForm {
                display: none !important;
            }
            /* Đảm bảo nội dung chính (hóa đơn) chiếm toàn bộ trang */
            body > main {
                width: 100%;
                margin: 0;
                padding: 0;
            }
            /* Xóa box-shadow của card để tiết kiệm mực */
            .card {
                box-shadow: none !important;
                border: 1px solid #dee2e6 !important;
            }
        }
    </style>
</head>
<body class="position-relative d-flex flex-column min-vh-100">

    <!-- ===== Top Navbar (logo + search + actions) ===== -->
    <header class="bg-white border-bottom position-relative">
        <partial name="_Header" />

        <!-- ===== Category bar ===== -->
        @await Component.InvokeAsync("MegaMenu")
    </header>

    <!-- ===== Hero chỉ cho Home/Index (banner + CTA) ===== -->
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        <div class="container my-4">
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            </div>

            <div class="carousel-inner">
                <div class="carousel-item active" data-bs-interval="5000">
                        <img src="~/image/banner1.png" class="d-block w-100" alt="Banner 1">
                </div>
                <div class="carousel-item" data-bs-interval="5000">
                        <img src="~/image/banner2.png" class="d-block w-100 " alt="Banner 2">
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        </div>

        <section class="hero">
            <div class="container py-4">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <div class="p-4 rounded-4" style="background:linear-gradient(135deg,#f97316,#fb923c); color:#111;">
                            <h2 class="mb-2 fw-bold">Đọc sách để thành công</h2>
                            <a asp-controller="Books" asp-action="Index" class="btn btn-light badge-pill px-4">Xem sách tại đây</a>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="p-3 rounded-4" style="background:#fff7ed; border:1px solid #fde7c7">
                            <div class="d-flex gap-3 align-items-center">
                                <div class="display-6"><i class="bi bi-pencil-square"></i></div>
                                <div>
                                    <div class="fw-bold">Blog sách</div>
                                    <div class="text-muted small">Khám phá các bài viết, đánh giá và tin tức mới nhất từ chúng tôi!</div>
                                </div>
                            </div>
                            <div class="text-end mt-3">
                                <a asp-controller="Blog" asp-action="Index" asp-area="" class="btn btn-outline-primary btn-sm">Xem Blog</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <main class="container my-4 flex-grow-1" >
        @if (TempData["CheckoutSuccess"] is string msg)
        {
            <div class="alert alert-success text-center">@msg</div>
        }
        @RenderBody()
    </main>

    <partial name="_Toast" />

    <partial name="_Footer" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("megaMenuToggle");
            // Lấy nút mới cho mobile
            const toggleBtnMobile = document.getElementById("megaMenuToggleMobile");
            const closeBtn = document.getElementById("megaMenuClose");
            const menu = document.getElementById("megaMenu");

            // Hàm để bật/tắt menu
            function toggleMenu(e) {
                if (menu) {
                    e.stopPropagation(); // Ngăn click lan ra body
                    var isHidden = menu.style.display === "none" || menu.style.display === "";
                    menu.style.display = isHidden ? "block" : "none";
                }
            }

            if (toggleBtn) {
                // Gán sự kiện cho nút desktop
                toggleBtn.addEventListener("click", toggleMenu);
            }

            if (toggleBtnMobile) {
                // Gán sự kiện cho nút mobile
                toggleBtnMobile.addEventListener("click", toggleMenu);
            }

            if (closeBtn && menu) {
                closeBtn.addEventListener("click", function () {
                    menu.style.display = "none";
                });
            }

            // Đóng menu khi click vào 1 link
            if (menu) {
                menu.querySelectorAll('.mega-menu-link').forEach(link => {
                    link.addEventListener('click', () => {
                        menu.style.display = 'none';
                    });
                });
            }

            // Tùy chọn: Đóng menu khi click ra ngoài
            document.addEventListener("click", function (e) {
                // Thêm kiểm tra cho cả 2 nút
                let clickedToggle = (toggleBtn && toggleBtn.contains(e.target));
                let clickedToggleMobile = (toggleBtnMobile && toggleBtnMobile.contains(e.target));

                if (menu && menu.style.display === "block" && !menu.contains(e.target) && !clickedToggle && !clickedToggleMobile) {
                    menu.style.display = "none";
                }
            });
        });

    </script>
    @await RenderSectionAsync("Scripts", required: false)
