@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BookStore</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-animations.css" asp-append-version="true" />
    <style>
        .logo-font {
            /* Dùng font 'Merriweather' mới, nếu không có thì dùng font serif mặc định */
            font-family: 'Merriweather', serif;
            font-weight: 700;
            font-size: 1.1rem; /* Hơi to hơn một chút */
        }

        /* Header icons - đồng bộ kích cỡ và hiệu ứng hover */
        .navbar-nav .nav-link i.bi {
            font-size: 1.25rem;
            transition: transform 0.3s ease, color 0.3s ease;
            display: inline-block;
        }
        
        .navbar-nav .nav-link:hover i.bi {
            transform: scale(1.15);
            color: var(--brand, #3b61eb);
        }
        
        .navbar-nav .nav-link:active i.bi {
            transform: scale(1.05);
        }

        @@media print {
            /* Ẩn Header, Footer, và Mega Menu */
            body > header,
            body > footer,
            #megaMenu {
                display: none !important;
            }
            /* Ẩn các nút bấm trên trang Details */
            #printInvoiceBtn,
            #cancelForm {
                display: none !important;
            }
            /* Đảm bảo nội dung chính (hóa đơn) chiếm toàn bộ trang */
            body > main {
                width: 100%;
                margin: 0;
                padding: 0;
            }
            /* Xóa box-shadow của card để tiết kiệm mực */
            .card {
                box-shadow: none !important;
                border: 1px solid #dee2e6 !important;
            }
        }
    </style>
</head>
<body class="position-relative d-flex flex-column min-vh-100">

    <!-- ===== Top Navbar (logo + search + actions) ===== -->
    <header class="bg-white border-bottom position-relative" id="mainHeader">
        <partial name="_Header" />

        <!-- ===== Category bar ===== -->
        @await Component.InvokeAsync("MegaMenu")
    </header>

    <!-- ===== Hero chỉ cho Home/Index (banner + CTA) ===== -->
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        <div class="container my-4">
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            </div>

            <div class="carousel-inner">
                <div class="carousel-item active" data-bs-interval="5000">
                        <img src="~/image/banner1.png" class="d-block w-100" alt="Banner 1">
                </div>
                <div class="carousel-item" data-bs-interval="5000">
                        <img src="~/image/banner2.png" class="d-block w-100 " alt="Banner 2">
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        </div>

        <section class="hero">
            <div class="container py-4">
                <div class="row align-items-stretch g-4">
                    <div class="col-lg-4">
                        <a asp-controller="Books" asp-action="Index" class="text-decoration-none h-100 d-block">
                            <div class="hero-card h-100 p-4 rounded-4" style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:#fff;">
                                <div class="d-flex gap-3 align-items-start mb-3">
                                    <div class="hero-icon"><i class="bi bi-book"></i></div>
                                    <div class="flex-grow-1">
                                        <h3 class="mb-2 fw-bold hero-title">Đọc sách để thành công</h3>
                                        <p class="mb-0 hero-description opacity-90">Khám phá thế giới sách và mở rộng tri thức của bạn!</p>
                                    </div>
                                </div>
                                <div class="text-end mt-auto">
                                    <span class="btn btn-light btn-sm rounded-pill px-4">Xem sách tại đây</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-4">
                        <a asp-controller="Coupons" asp-action="Index" asp-area="" class="text-decoration-none h-100 d-block">
                            <div class="hero-card h-100 p-4 rounded-4" style="background:linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color:#fff;">
                                <div class="d-flex gap-3 align-items-start mb-3">
                                    <div class="hero-icon"><i class="bi bi-ticket-perforated"></i></div>
                                    <div class="flex-grow-1">
                                        <h3 class="mb-2 fw-bold hero-title">Mã giảm giá</h3>
                                        <p class="mb-0 hero-description opacity-90">Khám phá các mã giảm giá hấp dẫn dành cho bạn!</p>
                                    </div>
                                </div>
                                <div class="text-end mt-auto">
                                    <span class="btn btn-light btn-sm rounded-pill px-4">Xem mã giảm giá</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-lg-4">
                        <a asp-controller="Blog" asp-action="Index" asp-area="" class="text-decoration-none h-100 d-block">
                            <div class="hero-card h-100 p-4 rounded-4" style="background:linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color:#fff;">
                                <div class="d-flex gap-3 align-items-start mb-3">
                                    <div class="hero-icon"><i class="bi bi-pencil-square"></i></div>
                                    <div class="flex-grow-1">
                                        <h3 class="mb-2 fw-bold hero-title">Blog sách</h3>
                                        <p class="mb-0 hero-description opacity-90">Khám phá các bài viết, đánh giá và tin tức mới nhất từ chúng tôi!</p>
                                    </div>
                                </div>
                                <div class="text-end mt-auto">
                                    <span class="btn btn-light btn-sm rounded-pill px-4">Xem Blog</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }

    <main class="container my-4 flex-grow-1" >
        @if (TempData["CheckoutSuccess"] is string msg)
        {
            <div class="alert alert-success text-center">@msg</div>
        }
        @RenderBody()
    </main>

    <partial name="_Toast" />

    <partial name="_Footer" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/page-animations.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Sticky header effect
            const header = document.getElementById("mainHeader");
            if (header) {
                window.addEventListener("scroll", function() {
                    if (window.scrollY > 50) {
                        header.classList.add("scrolled");
                    } else {
                        header.classList.remove("scrolled");
                    }
                });
            }
            
            // Xử lý Mega Menu - Đơn giản và rõ ràng
            const toggleBtn = document.getElementById("megaMenuToggle");
            const toggleBtnMobile = document.getElementById("megaMenuToggleMobile");
            const closeBtn = document.getElementById("megaMenuClose");
            const menu = document.getElementById("megaMenu");

            if (!menu) return;

            // Hàm toggle menu
            function toggleMegaMenu(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                const isShowing = menu.classList.contains("show");
                if (isShowing) {
                    menu.classList.remove("show");
                } else {
                    menu.classList.add("show");
                }
            }

            // Click handler cho desktop
            if (toggleBtn) {
                toggleBtn.onclick = function(e) {
                    toggleMegaMenu(e);
                    return false;
                };
                
                // Desktop hover (bổ sung)
                if (window.innerWidth > 991) {
                    let hoverTimeout;
                    toggleBtn.onmouseenter = function() {
                        clearTimeout(hoverTimeout);
                        menu.classList.add("show");
                    };
                    toggleBtn.onmouseleave = function() {
                        hoverTimeout = setTimeout(() => {
                            menu.classList.remove("show");
                        }, 200);
                    };
                    menu.onmouseenter = function() {
                        clearTimeout(hoverTimeout);
                    };
                    menu.onmouseleave = function() {
                        hoverTimeout = setTimeout(() => {
                            menu.classList.remove("show");
                        }, 200);
                    };
                }
            }

            // Mobile click
            if (toggleBtnMobile) {
                toggleBtnMobile.onclick = function(e) {
                    toggleMegaMenu(e);
                    return false;
                };
            }

            // Đóng menu khi click nút close
            if (closeBtn) {
                closeBtn.onclick = function() {
                    menu.classList.remove("show");
                };
            }

            // Đóng menu khi click vào link (mobile)
            if (menu) {
                menu.querySelectorAll('.mega-menu-link').forEach(link => {
                    link.onclick = function() {
                        if (window.innerWidth <= 991) {
                            menu.classList.remove("show");
                        }
                    };
                });
            }

            // Đóng menu khi click ra ngoài (mobile)
            document.onclick = function(e) {
                if (window.innerWidth <= 991 && menu && menu.classList.contains("show")) {
                    const clickedToggle = (toggleBtn && toggleBtn.contains(e.target));
                    const clickedToggleMobile = (toggleBtnMobile && toggleBtnMobile.contains(e.target));
                    const clickedMenu = menu.contains(e.target);

                    if (!clickedMenu && !clickedToggle && !clickedToggleMobile) {
                        menu.classList.remove("show");
                    }
                }
            };
        });

    </script>
    @await RenderSectionAsync("Scripts", required: false)
