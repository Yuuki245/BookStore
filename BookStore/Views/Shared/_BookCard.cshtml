@model BookStore.Models.Book

<div class="card h-100 book-card" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "Books", new { id = Model.Id })'">
    <div class="position-relative">
        <img src="@(Model.CoverUrl ?? "/images/no-cover.png")"
             class="card-img-top" alt="@Model.Title" />

        @{
            var tagType = ViewData["TagType"] as string;
        }
        @if (tagType == "FlashSale" && Model.IsOnFlashSale)
        {
            <div class="position-absolute top-0 start-0 condition-badge" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); color: white;">
                <i class="bi bi-lightning-charge-fill"></i> Flash Sale -@Model.FlashSale.DiscountPercent%
            </div>
        }
        else if (tagType == "Bestseller")
        {
            <div class="position-absolute top-0 start-0 condition-badge bestseller-badge">
                <i class="bi bi-star-fill"></i> Bestseller
            </div>
        }
        else if (tagType == "New")
        {
            <div class="position-absolute top-0 start-0 condition-badge new-badge">
                Mới
            </div>
        }
        else if (tagType == "Recommend")
        {
            <div class="position-absolute top-0 start-0 condition-badge" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <i class="bi bi-lightbulb-fill"></i> Đề xuất
            </div>
        }
        else if (Model.IsOnFlashSale)
        {
            <div class="position-absolute top-0 start-0 condition-badge" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%); color: white;">
                <i class="bi bi-lightning-charge-fill"></i> -@Model.FlashSale.DiscountPercent%
            </div>
        }
        else if (Model.OriginalPrice != null && Model.OriginalPrice > 0)
        {
            var discount = (int)Math.Round((1 - (Model.Price / Model.OriginalPrice.Value)) * 100);
            <div class="position-absolute top-0 start-0 condition-badge sale-badge">
                -@discount%
            </div>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h6 class="title" title="@Model.Title">@Model.Title</h6>
        <div class="book-meta mb-2">@Model.Author</div>
        <div class="mt-auto d-flex justify-content-between align-items-end">
            <div class="book-price">
                @if (Model.IsOnFlashSale)
                {
                    <div class="text-danger fw-bold">@($"{Model.FinalPrice:N0}đ")</div>
                    <div class="text-muted text-decoration-line-through small" style="font-size: 0.85rem; font-weight: normal;">
                        @($"{Model.Price:N0}đ")
                    </div>
                }
                else if (Model.OriginalPrice != null)
                {
                    <div class="text-danger">@($"{Model.Price:N0}đ")</div>
                    <div class="text-muted text-decoration-line-through small" style="font-size: 0.85rem; font-weight: normal;">
                        @($"{Model.OriginalPrice.Value:N0}đ")
                    </div>
                }
                else
                {
                    <div class="text-success">@($"{Model.Price:N0}đ")</div>
                }
            </div>

            <div class="btn-group" role="group" onclick="event.stopPropagation();">
                @await Component.InvokeAsync("WishlistButton", new { bookId = Model.Id })
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-primary rounded-circle" 
                            style="width: 36px; height: 36px; padding: 0; display: flex; align-items: center; justify-content: center;"
                            title="Thêm vào giỏ">
                        <i class="bi bi-bag-plus"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>