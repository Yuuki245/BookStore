@model string
@{
    var (bg, statusText) = Model switch
    {
        "Pending" => ("secondary", "Chờ xử lý"),
        "Confirmed" => ("primary", "Đã xác nhận"),
        "Shipped" => ("info", "Đang giao hàng"),
        "Completed" => ("success", "Hoàn thành"),
        "Canceled" => ("danger", "Đã hủy"),
        _ => ("secondary", Model)
    };
}
<span class="badge text-bg-@bg">@statusText</span>
