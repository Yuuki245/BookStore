@model string
@{
    var (bgClass, statusText, iconClass) = Model switch
    {
        "Pending" => ("status-badge-pending", "Chờ xử lý", "bi-clock-history"),
        "Confirmed" => ("status-badge-confirmed", "Đã xác nhận", "bi-check-circle"),
        "Shipped" => ("status-badge-shipped", "Đang giao hàng", "bi-truck"),
        "Completed" => ("status-badge-completed", "Hoàn thành", "bi-check2-circle"),
        "Canceled" => ("status-badge-canceled", "Đã hủy", "bi-x-circle"),
        _ => ("status-badge-unknown", Model ?? "N/A", "bi-question-circle")
    };
}
<span class="status-badge @bgClass">
    <i class="bi @iconClass me-1"></i>@statusText
</span>
