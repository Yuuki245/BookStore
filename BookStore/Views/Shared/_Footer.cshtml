<footer class="footer-blue mt-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-12 col-md-3">
                <h5 class="mb-3 text-white">qkt book.</h5>
                <div class="d-flex gap-2">
                    <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Tải trên App Store" height="40">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg" alt="Tải trên Google Play" height="40">
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="title">Cửa hàng</div>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Index" asp-area="">Nhà sách</a></li>
                    <li><a asp-controller="Books" asp-action="Index" asp-area="">Bộ sưu tập</a></li>
                    <li><a asp-controller="Blog" asp-action="Index" asp-area="">Blog</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-2">
                <div class="title">Công ty</div>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="About" asp-area="">Về chúng tôi</a></li>
                    <li><a asp-controller="Home" asp-action="TrustAndSafety" asp-area="">Tin cậy & An toàn</a></li>

                </ul>
            </div>
            <div class="col-6 col-md-3">
                <div class="title">Hỗ trợ</div>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Privacy" asp-area="">Chính sách Bảo mật</a></li>
                    <li><a asp-controller="Home" asp-action="Contact" asp-area="">Liên hệ</a></li>
                    <li><a asp-controller="Home" asp-action="FeatureRequests" asp-area="">Góp ý Tính năng</a></li>
                </ul>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top border-light-subtle small">
            <div>© @DateTime.Now.Year - BookStore</div>
            <div class="d-flex gap-3">
                <a href="https://facebook.com/YourPageName" target="_blank" rel="noopener noreferrer"><i class="bi bi-facebook"></i></a>
                <a href="https://instagram.com/YourHandle" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram"></i></a>
                <a href="https://twitter.com/YourHandle" target="_blank" rel="noopener noreferrer"><i class="bi bi-twitter-x"></i></a>           
            </div>
        </div>
    </div>
