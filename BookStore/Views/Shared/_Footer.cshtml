<!-- ===== Footer xanh ===== -->
<footer class="footer-blue mt-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-12 col-md-3">
                <h5 class="mb-3 text-white">qkt book.</h5>
                <div class="d-flex gap-2">
                    <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="App Store" height="40">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg" alt="Google Play" height="40">
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="title">Shop</div>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Index" asp-area="">Bookstores</a></li>
                    <li><a asp-controller="Books" asp-action="Index" asp-area="">Collections</a></li>
                    <li><a asp-controller="Blog" asp-action="Index" asp-area="">Blog</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-2">
                <div class="title">Company</div>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                    <li><a asp-controller="Home" asp-action="TrustAndSafety">Trust and Safety</a></li>
                    
                </ul>
            </div>
            <div class="col-6 col-md-3">
                <div class="title">Help</div>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    <li><a href="#">Contact Us</a></li>
                    <li><a href="#">Feature Requests</a></li>
                </ul>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top border-light-subtle small">
            <div>© @DateTime.Now.Year - BookStore</div>
            <div class="d-flex gap-3">
                <a href="https://facebook.com/YourPageName" target="_blank" rel="noopener noreferrer"><i class="bi bi-facebook"></i></a>
                <a href="https://instagram.com/YourHandle" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram"></i></a>
                <a href="https://twitter.com/YourHandle" target="_blank" rel="noopener noreferrer"><i class="bi bi-twitter-x"></i></a>            </div>
        </div>
    </div>
</footer>