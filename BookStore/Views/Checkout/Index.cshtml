@model BookStore.Models.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Thanh toán";

    // Tính toán logic giảm giá
    decimal subtotal = Model.Subtotal;
    decimal discountAmount = 0;
    string discountMessage = "";

    if (subtotal >= 5000000)
    {
        discountAmount = 500000;
        discountMessage = "Giảm giá (Đơn hàng > 5Tr)";
    }
    else if (subtotal >= 2000000)
    {
        discountAmount = 100000;
        discountMessage = "Giảm giá (Đơn hàng > 2Tr)";
    }
    else if (subtotal >= 1000000)
    {
        discountAmount = 70000;
        discountMessage = "Giảm giá (Đơn hàng > 1Tr)";
    }
    else if (subtotal >= 500000)
    {
        discountAmount = 50000;
        discountMessage = "Giảm giá (Đơn hàng > 500k)";
    }
    else if (subtotal >= 200000)
    {
        discountAmount = 10000;
        discountMessage = "Giảm giá (Đơn hàng > 200k)";
    }

    decimal finalTotal = subtotal - discountAmount;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
        <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
    </ol>
</nav>

<div class="row g-4">
    <!-- Cột trái: Form thông tin -->
    <div class="col-lg-8">
        <!-- Thông tin giao hàng -->
        <div class="card fade-in mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-geo-alt-fill me-2"></i>Thông tin giao hàng
                </h5>
            </div>
            <div class="card-body p-4">
                <form method="post" id="checkoutForm">
                    @Html.AntiForgeryToken()
                    @* Thêm hidden inputs cho selectedBookIds *@
                    @foreach (var item in Model.Items)
                    {
                        <input type="hidden" name="selectedBookIds" value="@item.BookId" />
                    }
                    @* Hidden input cho CouponCode - phải nằm trong form để được gửi đi *@
                    <input type="hidden" asp-for="CouponCode" id="couponCodeHidden" />
                    @* Hidden input cho PaymentMethod *@
                    <input type="hidden" asp-for="PaymentMethod" id="paymentMethodHidden" value="COD" />
                    @* Hidden input cho AddressId và PointsToUse *@
                    <input type="hidden" asp-for="AddressId" id="addressIdHidden" />
                    <input type="hidden" asp-for="PointsToUse" id="pointsToUseHidden" />
                    @if (ViewData.ModelState.Any(x => x.Value?.Errors?.Count > 0))
                    {
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                    }

                    @* Chọn địa chỉ đã lưu *@
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="form-label fw-semibold mb-0">
                                <i class="bi bi-bookmark-star me-1"></i>Địa chỉ giao hàng
                            </label>
                            <a asp-area="" asp-controller="Addresses" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-geo-alt me-1"></i>Quản lý địa chỉ
                            </a>
                        </div>
                        @if (Model.SavedAddresses != null && Model.SavedAddresses.Any())
                        {
                            var defaultAddress = Model.SavedAddresses.FirstOrDefault(a => a.IsDefault) ?? Model.SavedAddresses.First();
                            var otherAddresses = Model.SavedAddresses.Where(a => a.Id != defaultAddress.Id).ToList();
                            
                            @* Hiển thị địa chỉ mặc định *@
                            <div class="card border-primary mb-3 default-address-card" style="background: linear-gradient(135deg, rgba(59, 97, 235, 0.05) 0%, rgba(59, 97, 235, 0.02) 100%);">
                                <div class="card-body">
                                    <div class="d-flex align-items-start justify-content-between">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center mb-2">
                                                <span class="badge bg-primary me-2">
                                                    <i class="bi bi-star-fill me-1"></i>Địa chỉ mặc định
                                                </span>
                                            </div>
                                            <div class="fw-semibold mb-1">
                                                <i class="bi bi-telephone me-1 text-primary"></i>@defaultAddress.Phone
                                            </div>
                                            <div class="text-muted small">
                                                <i class="bi bi-geo-alt me-1"></i>@defaultAddress.Address
                                            </div>
                                        </div>
                                        <input type="radio" name="selectedAddress" 
                                               id="address_@defaultAddress.Id" 
                                               value="@defaultAddress.Id"
                                               checked
                                               class="form-check-input mt-1" 
                                               onchange="selectSavedAddress(@defaultAddress.Id, '@Html.Raw(defaultAddress.Address.Replace("'", "\\'").Replace("\"", "&quot;"))', '@defaultAddress.Phone')" />
                                    </div>
                                </div>
                            </div>
                            
                            @* Dropdown cho các địa chỉ khác *@
                            @if (otherAddresses.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small mb-2">
                                        <i class="bi bi-list-ul me-1"></i>Chọn địa chỉ khác
                                    </label>
                                    <select class="form-select" id="otherAddressesSelect" onchange="selectOtherAddress(this.value)">
                                        <option value="">-- Chọn địa chỉ khác --</option>
                                        @foreach (var addr in otherAddresses)
                                        {
                                            <option value="@addr.Id" 
                                                    data-address="@Html.Raw(addr.Address.Replace("'", "\\'").Replace("\"", "&quot;"))" 
                                                    data-phone="@addr.Phone">
                                                @addr.Phone - @addr.Address
                                            </option>
                                        }
                                    </select>
                                </div>
                                @* Hidden radio buttons cho các địa chỉ khác *@
                                @foreach (var addr in otherAddresses)
                                {
                                    <input type="radio" name="selectedAddress" 
                                           id="address_@addr.Id" 
                                           value="@addr.Id"
                                           class="d-none" 
                                           onchange="selectSavedAddress(@addr.Id, '@Html.Raw(addr.Address.Replace("'", "\\'").Replace("\"", "&quot;"))', '@addr.Phone')" />
                                }
                            }
                            
                            @* Tùy chọn nhập địa chỉ mới *@
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="selectedAddress" 
                                       id="address_new" 
                                       value="new"
                                       onchange="selectNewAddress()" />
                                <label class="form-check-label" for="address_new">
                                    <i class="bi bi-plus-circle me-1"></i><strong>Nhập địa chỉ mới</strong>
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info mb-3">
                                <i class="bi bi-info-circle me-2"></i>
                                Bạn chưa có địa chỉ nào. <a asp-area="" asp-controller="Addresses" asp-action="Create" target="_blank">Thêm địa chỉ mới</a> để mua hàng nhanh hơn.
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="selectedAddress" 
                                       id="address_new" 
                                       value="new"
                                       checked 
                                       onchange="selectNewAddress()" />
                                <label class="form-check-label" for="address_new">
                                    <i class="bi bi-plus-circle me-1"></i><strong>Nhập địa chỉ mới</strong>
                                </label>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="ShippingAddress" class="form-label fw-semibold">
                            <i class="bi bi-house-door me-1"></i>Địa chỉ giao hàng
                        </label>
                        <input asp-for="ShippingAddress" 
                               id="shippingAddressInput"
                               class="form-control form-control-lg" 
                               placeholder="Nhập địa chỉ đầy đủ của bạn" />
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>Vui lòng nhập địa chỉ chính xác để nhận hàng
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">
                            <i class="bi bi-telephone me-1"></i>Số điện thoại
                        </label>
                        <input asp-for="PhoneNumber" 
                               id="phoneNumberInput"
                               class="form-control form-control-lg" 
                               placeholder="0123456789" 
                               type="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        <div class="form-text">
                            <i class="bi bi-info-circle me-1"></i>Số điện thoại để liên hệ khi giao hàng
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Phương thức thanh toán -->
        <div class="card fade-in">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-credit-card me-2"></i>Phương thức thanh toán
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- COD Payment Method -->
                <div class="payment-method-card active" data-payment="COD" onclick="selectPaymentMethod('COD')" style="cursor: pointer;">
                    <div class="d-flex align-items-center">
                        <div class="payment-icon me-3">
                            <i class="bi bi-truck fs-1 text-primary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1 fw-bold">Thanh toán khi nhận hàng (COD)</h6>
                            <p class="text-muted mb-0 small">
                                <i class="bi bi-shield-check me-1 text-success"></i>
                                Thanh toán bằng tiền mặt khi nhận được hàng. An toàn và tiện lợi.
                            </p>
                        </div>
                        <div class="payment-check">
                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                        </div>
                    </div>
                </div>

                <!-- QKT Payment Method -->
                <div class="payment-method-card mt-3" data-payment="QKT" onclick="selectPaymentMethod('QKT')" style="cursor: pointer;">
                    <div class="d-flex align-items-center">
                        <div class="payment-icon me-3">
                            <i class="bi bi-credit-card-2-front fs-1 text-primary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1 fw-bold">Thanh toán trực tuyến (QKT Payment)</h6>
                            <p class="text-muted mb-0 small">
                                <i class="bi bi-lock-fill me-1 text-success"></i>
                                Thanh toán an toàn bằng thẻ tín dụng/ghi nợ qua cổng QKT Payment. Bảo mật và nhanh chóng.
                            </p>
                        </div>
                        <div class="payment-check">
                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3 mb-0" id="paymentInfoAlert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Lưu ý:</strong> <span id="paymentInfoText">Bạn sẽ thanh toán cho nhân viên giao hàng khi nhận được sản phẩm.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Tóm tắt đơn hàng -->
    <div class="col-lg-4">
        <div class="card fade-in" style="position: sticky; top: 100px;">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-receipt-cutoff me-2"></i>Tóm tắt đơn hàng
                </h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.Items.Any())
                {
                    <div class="empty-state text-center py-4 px-3">
                        <div class="empty-state-icon">🛒</div>
                        <p class="text-muted mb-0">Giỏ hàng trống.</p>
                    </div>
                }
                else
                {
                    <!-- Danh sách sản phẩm -->
                    <div class="p-3 border-bottom checkout-summary-scroll" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var it in Model.Items)
                        {
                            <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                <img src="@(it.CoverUrl ?? "/images/no-cover.png")" 
                                     class="rounded me-3" 
                                     style="width: 60px; height: 80px; object-fit: cover;" 
                                     alt="@it.Title" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@it.Title</div>
                                    <div class="text-muted small">Số lượng: @it.Quantity</div>
                                    <div class="text-primary fw-bold mt-1">
                                        @((it.UnitPrice * it.Quantity).ToString("N0")) ₫
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Chi tiết thanh toán -->
                    <div class="p-3 bg-light">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính</span>
                            <span class="fw-semibold">@subtotal.ToString("N0") ₫</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển</span>
                            <span class="text-success fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Miễn phí
                            </span>
                        </div>

                        <!-- Sử dụng điểm tích lũy -->
                        <div class="mb-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="usePointsCheckbox" 
                                       onchange="togglePointsUsage()"
                                       @(Model.AvailablePoints < 10 ? "disabled" : "") />
                                <label class="form-check-label fw-semibold" for="usePointsCheckbox">
                                    <i class="bi bi-star-fill me-1 text-warning"></i>Sử dụng điểm tích lũy
                                    <span class="badge bg-warning text-dark ms-2">Bạn có @Model.AvailablePoints điểm</span>
                                </label>
                            </div>
                            @if (Model.AvailablePoints < 10)
                            {
                                <div class="alert alert-info mb-2">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Cần tối thiểu <strong>10 điểm</strong> để sử dụng. Bạn hiện có <strong>@Model.AvailablePoints điểm</strong>.
                                </div>
                            }
                            <div id="pointsInputGroup" style="display: none;">
                                <div class="input-group">
                                    <input type="number" id="pointsToUseInput" 
                                           class="form-control" 
                                           placeholder="Nhập số điểm (tối thiểu 10)" 
                                           min="10" 
                                           max="@Model.AvailablePoints"
                                           value="10" />
                                    <button type="button" id="applyPointsBtn" class="btn btn-outline-warning">
                                        <i class="bi bi-check-circle me-1"></i>Áp dụng
                                    </button>
                                </div>
                                <div class="form-text small">
                                    <i class="bi bi-info-circle me-1"></i>1 điểm = 1.000₫. Tối thiểu 10 điểm, tối đa @Model.AvailablePoints điểm.
                                </div>
                                <div id="pointsMessage" class="mt-2" style="min-height: 24px;"></div>
                            </div>
                        </div>

                        <!-- Mã giảm giá -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-ticket-perforated me-1"></i>Mã giảm giá
                            </label>
                            <div class="input-group">
                                <input type="text" id="couponCode" class="form-control" placeholder="Nhập mã giảm giá" style="text-transform: uppercase;" />
                                <button type="button" id="applyCouponBtn" class="btn btn-outline-primary">
                                    <i class="bi bi-check-circle me-1"></i>Áp dụng
                                </button>
                            </div>
                            <div id="couponMessage" class="mt-2" style="min-height: 24px;"></div>
                            @* CouponCode đã được di chuyển vào trong form checkoutForm *@
                        </div>

                        @if (discountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success" id="autoDiscountRow">
                                <span class="fw-semibold">
                                    <i class="bi bi-gift me-1"></i>@discountMessage
                                </span>
                                <span class="fw-bold">- @discountAmount.ToString("N0") ₫</span>
                            </div>
                        }

                        <div id="pointsDiscountRow" class="d-flex justify-content-between mb-2 text-warning" style="display: none;">
                            <span class="fw-semibold">
                                <i class="bi bi-star-fill me-1"></i>Giảm giá từ điểm
                            </span>
                            <span class="fw-bold" id="pointsDiscountAmount">- 0 ₫</span>
                        </div>

                        <div id="couponDiscountRow" class="d-flex justify-content-between mb-2 text-success" style="display: none;">
                            <span class="fw-semibold">
                                <i class="bi bi-ticket-perforated me-1"></i>Giảm giá từ mã
                            </span>
                            <span class="fw-bold" id="couponDiscountAmount">- 0 ₫</span>
                        </div>

                        <hr class="my-3" />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold fs-5">Tổng cộng</span>
                            <span class="fw-bold fs-4 text-success" id="finalTotal">@finalTotal.ToString("N0") ₫</span>
                        </div>

                        <div id="savingsAlert" class="alert alert-success mb-0" style="display: none;">
                            <small>
                                <i class="bi bi-gift-fill me-1"></i>
                                Bạn đã tiết kiệm được <strong id="totalSavings">0</strong> ₫!
                            </small>
                        </div>
                    </div>

                    <!-- Nút đặt hàng -->
                    <div class="p-3 border-top">
                        <button type="submit" form="checkoutForm" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-bag-check me-2"></i>
                            Đặt hàng ngay
                        </button>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="bi bi-arrow-left me-2"></i>
                            Quay lại giỏ hàng
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .payment-method-card {
        border: 2px solid #e5e7eb;
        border-radius: var(--radius);
        padding: 1.5rem;
        transition: all var(--transition-base);
        background: #fff;
    }

    .payment-method-card.active {
        border-color: var(--brand);
        background: #f0f7ff;
        box-shadow: 0 4px 12px rgba(59, 97, 235, 0.1);
    }

    .payment-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6f1ff;
        border-radius: var(--radius);
    }

    .payment-check {
        opacity: 0;
        transition: opacity var(--transition-base);
    }

    .payment-method-card.active .payment-check {
        opacity: 1;
    }

    .form-control-lg {
        padding: 0.75rem 1rem;
        font-size: 1rem;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 1.5rem;
    }

    .breadcrumb-item a {
        color: var(--brand);
        text-decoration: none;
    }

    .breadcrumb-item.active {
        color: var(--muted);
    }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .default-address-card {
        transition: all 0.3s ease;
    }

    .default-address-card:hover {
        box-shadow: 0 6px 16px rgba(59, 97, 235, 0.15);
        transform: translateY(-2px);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Đảm bảo DOM đã load xong
        document.addEventListener('DOMContentLoaded', function() {
            // Xử lý chọn phương thức thanh toán
            function selectPaymentMethod(method) {
                const paymentMethodHidden = document.getElementById('paymentMethodHidden');
                const paymentCards = document.querySelectorAll('.payment-method-card');
                const paymentInfoText = document.getElementById('paymentInfoText');
                
                if (paymentMethodHidden) {
                    paymentMethodHidden.value = method;
                }
                
                // Cập nhật UI
                paymentCards.forEach(card => {
                    if (card.dataset.payment === method) {
                        card.classList.add('active');
                    } else {
                        card.classList.remove('active');
                    }
                });
                
                // Cập nhật thông báo
                if (paymentInfoText) {
                    if (method === 'COD') {
                        paymentInfoText.textContent = 'Bạn sẽ thanh toán cho nhân viên giao hàng khi nhận được sản phẩm.';
                    } else if (method === 'QKT') {
                        paymentInfoText.textContent = 'Bạn sẽ được chuyển đến cổng thanh toán QKT Payment để hoàn tất thanh toán.';
                    }
                }
            }
            
            // Expose function globally
            window.selectPaymentMethod = selectPaymentMethod;
            
            // Xử lý mã giảm giá
            const couponCodeInput = document.getElementById('couponCode');
            const applyCouponBtn = document.getElementById('applyCouponBtn');
            const couponMessage = document.getElementById('couponMessage');
            const couponCodeHidden = document.getElementById('couponCodeHidden');
            const couponDiscountRow = document.getElementById('couponDiscountRow');
            const couponDiscountAmount = document.getElementById('couponDiscountAmount');
            const autoDiscountRow = document.getElementById('autoDiscountRow');
            const finalTotal = document.getElementById('finalTotal');
            const savingsAlert = document.getElementById('savingsAlert');
            const totalSavings = document.getElementById('totalSavings');

            let currentSubtotal = parseFloat('@subtotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)');
            let currentCouponDiscount = 0;
            let currentAutoDiscount = 0;
            let currentPointsDiscount = 0;
            let currentPointsToUse = 0;
            const availablePoints = @Model.AvailablePoints;

            // Hàm tính auto discount dựa trên số tiền còn lại sau coupon
            function calculateAutoDiscount(remainingAmount) {
                if (remainingAmount >= 5000000) {
                    return 500000;
                } else if (remainingAmount >= 2000000) {
                    return 100000;
                } else if (remainingAmount >= 1000000) {
                    return 70000;
                } else if (remainingAmount >= 500000) {
                    return 50000;
                } else if (remainingAmount >= 200000) {
                    return 10000;
                }
                return 0;
            }

            // Hàm cập nhật auto discount dựa trên số tiền còn lại sau coupon
            function updateAutoDiscount() {
                const remainingAfterCoupon = currentSubtotal - currentCouponDiscount;
                currentAutoDiscount = calculateAutoDiscount(remainingAfterCoupon);
                
                // Không được vượt quá số tiền còn lại
                if (currentAutoDiscount > remainingAfterCoupon) {
                    currentAutoDiscount = remainingAfterCoupon;
                }
                
                // Hiển thị auto discount
                if (autoDiscountRow) {
                    if (currentAutoDiscount > 0) {
                        autoDiscountRow.style.display = 'flex';
                        const discountText = autoDiscountRow.querySelector('span:last-child');
                        if (discountText) {
                            discountText.textContent = '- ' + currentAutoDiscount.toLocaleString('vi-VN') + ' ₫';
                        }
                    } else {
                        autoDiscountRow.style.display = 'none';
                    }
                }
            }

            function updateTotal() {
                if (!finalTotal) return;
                
                // Tính theo 3 tầng: subtotal - coupon - auto - points
                const total = currentSubtotal - currentCouponDiscount - currentAutoDiscount - currentPointsDiscount;
                finalTotal.textContent = total.toLocaleString('vi-VN') + ' ₫';
                
                const totalSavingsValue = currentCouponDiscount + currentAutoDiscount + currentPointsDiscount;
                if (savingsAlert && totalSavings) {
                    if (totalSavingsValue > 0) {
                        totalSavings.textContent = totalSavingsValue.toLocaleString('vi-VN');
                        savingsAlert.style.display = 'block';
                    } else {
                        savingsAlert.style.display = 'none';
                    }
                }
            }

            // Khởi tạo auto discount ban đầu (không có coupon)
            updateAutoDiscount();

            // Xử lý chọn địa chỉ đã lưu
            window.selectSavedAddress = function(addressId, address, phone) {
                document.getElementById('shippingAddressInput').value = address;
                document.getElementById('phoneNumberInput').value = phone;
                document.getElementById('addressIdHidden').value = addressId;
                // Reset dropdown
                const otherAddressesSelect = document.getElementById('otherAddressesSelect');
                if (otherAddressesSelect) {
                    otherAddressesSelect.value = '';
                }
            };

            window.selectOtherAddress = function(addressId) {
                if (!addressId) return;
                const select = document.getElementById('otherAddressesSelect');
                const option = select.options[select.selectedIndex];
                if (!option) return;
                
                let address = option.getAttribute('data-address');
                // Decode HTML entities
                address = address.replace(/&quot;/g, '"').replace(/\\'/g, "'");
                const phone = option.getAttribute('data-phone');
                
                // Set radio button
                const radio = document.getElementById('address_' + addressId);
                if (radio) {
                    radio.checked = true;
                }
                
                // Uncheck other radios
                document.querySelectorAll('input[name="selectedAddress"]').forEach(r => {
                    if (r.id !== 'address_' + addressId && r.id !== 'address_new') {
                        r.checked = false;
                    }
                });
                
                document.getElementById('shippingAddressInput').value = address;
                document.getElementById('phoneNumberInput').value = phone;
                document.getElementById('addressIdHidden').value = addressId;
            };

            window.selectNewAddress = function() {
                document.getElementById('shippingAddressInput').value = '';
                document.getElementById('phoneNumberInput').value = '';
                document.getElementById('addressIdHidden').value = '';
                // Reset dropdown
                const otherAddressesSelect = document.getElementById('otherAddressesSelect');
                if (otherAddressesSelect) {
                    otherAddressesSelect.value = '';
                }
            };

            // Tự động chọn địa chỉ mặc định khi trang load
            @if (Model.AddressId.HasValue && !string.IsNullOrEmpty(Model.ShippingAddress))
            {
                <text>
                // Điền thông tin địa chỉ mặc định từ model
                document.getElementById('shippingAddressInput').value = '@Html.Raw(Model.ShippingAddress.Replace("'", "\\'"))';
                document.getElementById('phoneNumberInput').value = '@Model.PhoneNumber';
                document.getElementById('addressIdHidden').value = '@Model.AddressId.Value';
                </text>
            }

            // Xử lý sử dụng điểm
            const usePointsCheckbox = document.getElementById('usePointsCheckbox');
            const pointsInputGroup = document.getElementById('pointsInputGroup');
            const pointsToUseInput = document.getElementById('pointsToUseInput');
            const applyPointsBtn = document.getElementById('applyPointsBtn');
            const pointsMessage = document.getElementById('pointsMessage');
            const pointsDiscountRow = document.getElementById('pointsDiscountRow');
            const pointsDiscountAmount = document.getElementById('pointsDiscountAmount');
            const pointsToUseHidden = document.getElementById('pointsToUseHidden');

            // Hàm bật/tắt sử dụng điểm
            window.togglePointsUsage = function() {
                if (usePointsCheckbox && pointsInputGroup) {
                    if (usePointsCheckbox.checked) {
                        pointsInputGroup.style.display = 'block';
                        if (pointsToUseInput) {
                            pointsToUseInput.value = '10'; // Mặc định 10 điểm
                            pointsToUseInput.focus();
                        }
                    } else {
                        pointsInputGroup.style.display = 'none';
                        // Xóa điểm đã áp dụng
                        currentPointsToUse = 0;
                        currentPointsDiscount = 0;
                        if (pointsToUseHidden) {
                            pointsToUseHidden.value = '0';
                        }
                        if (pointsDiscountRow) {
                            pointsDiscountRow.style.display = 'none';
                        }
                        if (pointsMessage) {
                            pointsMessage.innerHTML = '';
                            pointsMessage.style.display = 'none';
                        }
                        if (pointsToUseInput) {
                            pointsToUseInput.value = '10';
                        }
                        updateTotal();
                    }
                }
            };

            if (applyPointsBtn && pointsToUseInput) {
                applyPointsBtn.addEventListener('click', function() {
                    const points = parseInt(pointsToUseInput.value) || 0;
                    
                    if (points < 10) {
                        showPointsMessage('Số điểm tối thiểu là 10 điểm.', 'error');
                        return;
                    }
                    
                    if (points > availablePoints) {
                        showPointsMessage(`Bạn chỉ có ${availablePoints} điểm. Vui lòng nhập số điểm hợp lệ.`, 'error');
                        return;
                    }

                    // Tính toán giảm giá từ điểm (TẦNG 3: sau khi đã trừ coupon và auto discount)
                    const remainingAfterAutoDiscount = currentSubtotal - currentCouponDiscount - currentAutoDiscount;
                    
                    currentPointsToUse = points;
                    currentPointsDiscount = points * 1000; // 1 điểm = 1000đ
                    
                    // Không được vượt quá số tiền còn lại sau coupon và auto discount
                    if (currentPointsDiscount > remainingAfterAutoDiscount) {
                        currentPointsDiscount = remainingAfterAutoDiscount;
                        currentPointsToUse = Math.floor(remainingAfterAutoDiscount / 1000);
                        if (currentPointsToUse < 10) {
                            showPointsMessage('Số tiền còn lại sau giảm giá không đủ để sử dụng điểm (tối thiểu 10.000₫).', 'warning');
                            currentPointsToUse = 0;
                            currentPointsDiscount = 0;
                            if (pointsToUseInput) pointsToUseInput.value = '10';
                            if (pointsDiscountRow) pointsDiscountRow.style.display = 'none';
                            if (pointsToUseHidden) pointsToUseHidden.value = '0';
                            updateTotal();
                            return;
                        }
                        pointsToUseInput.value = currentPointsToUse;
                    }

                    if (pointsToUseHidden) {
                        pointsToUseHidden.value = currentPointsToUse;
                    }

                    if (pointsDiscountRow) pointsDiscountRow.style.display = 'flex';
                    if (pointsDiscountAmount) pointsDiscountAmount.textContent = '- ' + currentPointsDiscount.toLocaleString('vi-VN') + ' ₫';
                    
                    showPointsMessage(`Đã áp dụng ${currentPointsToUse} điểm (giảm ${currentPointsDiscount.toLocaleString('vi-VN')} ₫)`, 'success');
                    updateTotal();
                });

                // Cho phép nhấn Enter để áp dụng
                pointsToUseInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        applyPointsBtn.click();
                    }
                });
            }

            function showPointsMessage(message, type) {
                if (!pointsMessage) return;
                
                const typeClass = type === 'success' ? 'text-success' : 
                                 type === 'error' ? 'text-danger' : 
                                 type === 'warning' ? 'text-warning' : 'text-info';
                const icon = type === 'success' ? 'bi-check-circle' : 
                            type === 'error' ? 'bi-x-circle' : 
                            type === 'warning' ? 'bi-exclamation-triangle' : 'bi-info-circle';
                
                pointsMessage.innerHTML = `<div class="${typeClass} small fw-semibold animate-fade-in"><i class="bi ${icon} me-1"></i>${message}</div>`;
                pointsMessage.style.display = 'block';
            }

            function showCouponMessage(message, type) {
                if (!couponMessage) {
                    console.error('couponMessage element not found');
                    return;
                }
                
                const typeClass = type === 'success' ? 'text-success' : 
                                 type === 'error' ? 'text-danger' : 
                                 type === 'warning' ? 'text-warning' : 'text-info';
                const icon = type === 'success' ? 'bi-check-circle' : 
                            type === 'error' ? 'bi-x-circle' : 
                            type === 'warning' ? 'bi-exclamation-triangle' : 'bi-info-circle';
                
                couponMessage.innerHTML = `<div class="${typeClass} small fw-semibold animate-fade-in"><i class="bi ${icon} me-1"></i>${message}</div>`;
                couponMessage.style.display = 'block';
                
                // Scroll to message nếu cần
                couponMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            // Debug: Kiểm tra elements
            console.log('Coupon elements:', {
                applyCouponBtn: !!applyCouponBtn,
                couponCodeInput: !!couponCodeInput,
                couponMessage: !!couponMessage
            });

            if (applyCouponBtn && couponCodeInput) {
                applyCouponBtn.addEventListener('click', async function() {
                    const code = couponCodeInput.value.trim().toUpperCase();
                if (!code) {
                    showCouponMessage('Vui lòng nhập mã giảm giá.', 'error');
                    couponCodeInput.focus();
                    return;
                }

                // Disable button và hiển thị loading
                applyCouponBtn.disabled = true;
                const originalBtnText = applyCouponBtn.innerHTML;
                applyCouponBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra...';
                applyCouponBtn.classList.add('opacity-75');
                
                // Xóa thông báo cũ
                if (couponMessage) {
                    couponMessage.innerHTML = '';
                }

                try {
                    // Tạo AbortController để có thể timeout
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 giây timeout

                    const validateUrl = '@Url.Action("ValidateCoupon", "Checkout")';
                    console.log('Validating coupon at URL:', validateUrl, 'with code:', code, 'subtotal:', currentSubtotal);

                    // Sử dụng URLSearchParams để gửi dữ liệu dạng form-urlencoded (tương thích với model binding)
                    const params = new URLSearchParams();
                    params.append('couponCode', code);
                    params.append('subtotal', currentSubtotal.toString());

                    const response = await fetch(validateUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: params.toString(),
                        signal: controller.signal
                    });

                    clearTimeout(timeoutId);

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('HTTP error response:', response.status, errorText);
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    // Kiểm tra content type trước khi parse JSON
                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        const text = await response.text();
                        console.error('Unexpected response type:', contentType, text);
                        throw new Error('Server returned non-JSON response');
                    }

                    const data = await response.json();
                    console.log('Coupon validation response:', data);

                    if (data.success) {
                        if (couponCodeHidden) {
                            couponCodeHidden.value = code;
                        }
                        currentCouponDiscount = data.discount || 0;
                        
                        // Hiển thị coupon discount
                        if (currentCouponDiscount > 0) {
                            if (couponDiscountRow) couponDiscountRow.style.display = 'flex';
                            if (couponDiscountAmount) couponDiscountAmount.textContent = '- ' + currentCouponDiscount.toLocaleString('vi-VN') + ' ₫';
                            showCouponMessage(data.message || 'Áp dụng mã giảm giá thành công!', 'success');
                        } else {
                            if (couponDiscountRow) couponDiscountRow.style.display = 'none';
                        }

                        // Tính lại auto discount dựa trên số tiền còn lại sau coupon (TẦNG 2)
                        updateAutoDiscount();

                        // Nếu có điểm đang dùng, kiểm tra lại xem có vượt quá số tiền còn lại không (TẦNG 3)
                        if (currentPointsDiscount > 0 && usePointsCheckbox && usePointsCheckbox.checked) {
                            const remainingAfterAutoDiscount = currentSubtotal - currentCouponDiscount - currentAutoDiscount;
                            if (currentPointsDiscount > remainingAfterAutoDiscount) {
                                currentPointsDiscount = remainingAfterAutoDiscount;
                                currentPointsToUse = Math.floor(remainingAfterAutoDiscount / 1000);
                                if (currentPointsToUse < 10) {
                                    // Không đủ để dùng điểm, ẩn discount
                                    currentPointsToUse = 0;
                                    currentPointsDiscount = 0;
                                    if (pointsToUseInput) pointsToUseInput.value = '10';
                                    if (pointsToUseHidden) pointsToUseHidden.value = '0';
                                    if (pointsDiscountRow) pointsDiscountRow.style.display = 'none';
                                    if (pointsMessage) {
                                        showPointsMessage('Số tiền còn lại sau giảm giá không đủ để sử dụng điểm (tối thiểu 10.000₫).', 'warning');
                                    }
                                } else {
                                    if (pointsToUseInput) pointsToUseInput.value = currentPointsToUse;
                                    if (pointsToUseHidden) pointsToUseHidden.value = currentPointsToUse;
                                    if (pointsDiscountAmount) pointsDiscountAmount.textContent = '- ' + currentPointsDiscount.toLocaleString('vi-VN') + ' ₫';
                                }
                            }
                        }

                        updateTotal();
                    } else {
                        if (couponCodeHidden) {
                            couponCodeHidden.value = '';
                        }
                        currentCouponDiscount = 0;
                        if (couponDiscountRow) couponDiscountRow.style.display = 'none';
                        
                        // Tính lại auto discount khi không có coupon (TẦNG 2)
                        updateAutoDiscount();
                        
                        // Nếu có điểm đang dùng, kiểm tra lại
                        if (currentPointsDiscount > 0 && usePointsCheckbox && usePointsCheckbox.checked) {
                            const remainingAfterAutoDiscount = currentSubtotal - currentAutoDiscount;
                            if (currentPointsDiscount > remainingAfterAutoDiscount) {
                                currentPointsDiscount = remainingAfterAutoDiscount;
                                currentPointsToUse = Math.floor(remainingAfterAutoDiscount / 1000);
                            if (currentPointsToUse < 10) {
                                // Không đủ để dùng điểm, ẩn discount
                                currentPointsToUse = 0;
                                currentPointsDiscount = 0;
                                if (pointsToUseInput) pointsToUseInput.value = '10';
                                if (pointsToUseHidden) pointsToUseHidden.value = '0';
                                if (pointsDiscountRow) pointsDiscountRow.style.display = 'none';
                                if (pointsMessage) {
                                    showPointsMessage('Số tiền còn lại sau giảm giá không đủ để sử dụng điểm (tối thiểu 10.000₫).', 'warning');
                                }
                            } else {
                                if (pointsToUseInput) pointsToUseInput.value = currentPointsToUse;
                                if (pointsToUseHidden) pointsToUseHidden.value = currentPointsToUse;
                                if (pointsDiscountAmount) pointsDiscountAmount.textContent = '- ' + currentPointsDiscount.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                    
                    const messageType = data.message && data.message.includes('không tồn tại') ? 'error' : 'warning';
                    showCouponMessage(data.message || 'Mã giảm giá không hợp lệ.', messageType);
                    updateTotal();
                    }
                } catch (error) {
                    console.error('Error validating coupon:', error);
                    
                    let errorMessage = 'Có lỗi xảy ra khi kiểm tra mã giảm giá.';
                    if (error.name === 'AbortError') {
                        errorMessage = 'Yêu cầu quá thời gian chờ. Vui lòng kiểm tra kết nối và thử lại.';
                    } else if (error.message) {
                        errorMessage = error.message;
                    }
                    
                    showCouponMessage(errorMessage, 'error');
                } finally {
                    applyCouponBtn.disabled = false;
                    applyCouponBtn.innerHTML = originalBtnText || '<i class="bi bi-check-circle me-1"></i>Áp dụng';
                    applyCouponBtn.classList.remove('opacity-75');
                }
                });

                // Cho phép nhấn Enter để áp dụng
                couponCodeInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        applyCouponBtn.click();
                    }
                });
            } else {
                console.error('Coupon elements not found:', { applyCouponBtn, couponCodeInput });
            }

            // Form validation feedback
            const checkoutForm = document.getElementById('checkoutForm');
            const shippingAddressInput = document.getElementById('shippingAddressInput');
            const phoneNumberInput = document.getElementById('phoneNumberInput');
            
            if (checkoutForm && shippingAddressInput && phoneNumberInput) {
                checkoutForm.addEventListener('submit', function(e) {
                    const address = shippingAddressInput.value.trim();
                    const phone = phoneNumberInput.value.trim();
                    
                    if (!address || !phone) {
                        e.preventDefault();
                        alert('Vui lòng điền đầy đủ thông tin giao hàng!');
                        return false;
                    }
                    
                    // Đảm bảo nếu checkbox không được chọn thì không gửi điểm
                    if (usePointsCheckbox && !usePointsCheckbox.checked) {
                        if (pointsToUseHidden) {
                            pointsToUseHidden.value = '0';
                        }
                    }
                    
                    // Đảm bảo coupon code được gửi đi nếu đã áp dụng
                    if (couponCodeHidden && couponCodeHidden.value) {
                        console.log('Coupon code sẽ được gửi:', couponCodeHidden.value);
                    }
                    
                    // Đảm bảo điểm được gửi đi nếu đã áp dụng
                    if (pointsToUseHidden && pointsToUseHidden.value) {
                        console.log('Points to use sẽ được gửi:', pointsToUseHidden.value);
                    }
                });
            }
        }); // End DOMContentLoaded
    </script>
}
