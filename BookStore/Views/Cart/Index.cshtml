@model BookStore.ViewModels.CartVM
@{
    ViewData["Title"] = "Cart";
}

<h2>Cart</h2>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Giỏ hàng trống.</div>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Book</th><th>Price</th><th style="width:160px;">Qty</th><th>Total</th><th></th></tr></thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.Title</td>
                    <td>@i.UnitPrice.ToString("N0") ₫</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@i.BookId" />
                            <input type="number" name="qty" value="@i.Quantity" min="0" class="form-control" />
                            <button class="btn btn-outline-primary btn-sm">Update</button>
                        </form>
                    </td>
                    <td>@(i.UnitPrice * i.Quantity).ToString("N0") ₫</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@i.BookId" />
                            <button class="btn btn-outline-danger btn-sm">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Grand total:</th>
                <th>@Model.Total.ToString("N0") ₫</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Thanh toán</a>
}
