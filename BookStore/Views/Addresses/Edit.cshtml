@model BookStore.Models.Address
@{
    ViewData["Title"] = "Sửa địa chỉ";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-area="" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Địa chỉ</a></li>
            <li class="breadcrumb-item active">Sửa địa chỉ</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil me-2"></i>Sửa địa chỉ
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        @if (!string.IsNullOrEmpty(Context.Request.Query["returnUrl"]))
                        {
                            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
                        }
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                <i class="bi bi-telephone me-1"></i>Số điện thoại
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0123456789" type="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StreetAddress" class="form-label fw-semibold">
                                <i class="bi bi-house-door me-1"></i>Địa chỉ
                            </label>
                            <textarea asp-for="StreetAddress" class="form-control" rows="3" placeholder="Nhập địa chỉ đầy đủ của bạn"></textarea>
                            <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>Ví dụ: Số 123, Đường ABC, Phường XYZ, Quận 1, TP.HCM
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                            <label asp-for="IsDefault" class="form-check-label">
                                Đặt làm địa chỉ mặc định
                            </label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            @if (!string.IsNullOrEmpty(Context.Request.Query["returnUrl"]))
                            {
                                <a href="@Context.Request.Query["returnUrl"]" class="btn btn-outline-secondary">Hủy</a>
                            }
                            else
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                            }
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

