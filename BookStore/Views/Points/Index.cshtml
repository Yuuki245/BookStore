@model IEnumerable<BookStore.Models.PointTransaction>
@using BookStore.Helpers
@{
    ViewData["Title"] = "Điểm tích lũy";
    int totalPoints = ViewBag.TotalPoints ?? 0;
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-area="" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">Điểm tích lũy</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-star-fill me-2"></i>Điểm tích lũy hiện có
                    </h5>
                    <h2 class="mb-0">@totalPoints điểm</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle me-2"></i>Quy tắc sử dụng
                    </h5>
                    <ul class="mb-0 small">
                        <li>Mua hàng: 10.000₫ = 1 điểm</li>
                        <li>Sử dụng điểm: Tối thiểu 10 điểm</li>
                        <li>1 điểm = 1.000₫ giảm giá</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-clock-history me-2"></i>Lịch sử giao dịch điểm
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
                    <p class="text-muted">Chưa có giao dịch điểm nào</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày giờ</th>
                                <th>Loại giao dịch</th>
                                <th>Số điểm</th>
                                <th>Mô tả</th>
                                <th>Đơn hàng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trans in Model)
                            {
                                <tr>
                                    <td>@TimeHelper.ToVietnamTime(trans.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (trans.IsEarned)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-plus-circle me-1"></i>Tích điểm
                                            </span>
                                        }
                                        else if (trans.IsUsed)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-dash-circle me-1"></i>Sử dụng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@trans.TransactionType</span>
                                        }
                                    </td>
                                    <td class="fw-bold @(trans.Points > 0 ? "text-success" : "text-danger")">
                                        @if (trans.Points > 0)
                                        {
                                            <span>+@trans.Points</span>
                                        }
                                        else
                                        {
                                            <span>@trans.Points</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(trans.Description ?? "-")</td>
                                    <td>
                                        @if (trans.OrderId.HasValue)
                                        {
                                            <a asp-controller="Orders" asp-action="Details" asp-area="" asp-route-id="@trans.OrderId.Value"
                                               class="btn btn-sm btn-outline-primary">
                                                #@trans.OrderId.Value
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation" class="p-3">
                        <ul class="pagination justify-content-center mb-0">
                            @if (page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-area="" asp-route-page="@(page - 1)">Trước</a>
                                </li>
                            }
                            @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                            {
                                <li class="page-item @(i == page ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-area="" asp-route-page="@i">@i</a>
                                </li>
                            }
                            @if (page < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-area="" asp-route-page="@(page + 1)">Sau</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

