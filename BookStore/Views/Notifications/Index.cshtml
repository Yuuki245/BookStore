@model IEnumerable<BookStore.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Thông báo</h2>
        @if (ViewBag.Total > 0)
        {
            <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-check-all me-1"></i>Đánh dấu tất cả đã đọc
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-bell-slash text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 mb-2">Không có thông báo nào</h5>
                <p class="text-muted">Bạn chưa có thông báo nào.</p>
            </div>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notif in Model)
            {
                var typeClass = notif.Type == "Success" ? "text-success" : 
                               notif.Type == "Warning" ? "text-warning" : 
                               notif.Type == "Danger" ? "text-danger" : "text-info";
                var icon = notif.Type == "Success" ? "check-circle" : 
                          notif.Type == "Warning" ? "exclamation-triangle" : 
                          notif.Type == "Danger" ? "x-circle" : "info-circle";
                var bgClass = notif.IsRead ? "" : "bg-light";
                var borderClass = notif.IsRead ? "" : "border-start border-3 border-primary";

                <div class="list-group-item @bgClass @borderClass">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(notif.LinkUrl))
                            {
                                <a href="@notif.LinkUrl" class="text-decoration-none text-dark">
                                    <div class="@typeClass @(notif.IsRead ? "" : "fw-semibold")">
                                        <i class="bi bi-@icon me-2"></i>@notif.Title
                                    </div>
                                    <div class="text-muted mt-1">@notif.Message</div>
                                </a>
                            }
                            else
                            {
                                <div class="@typeClass @(notif.IsRead ? "" : "fw-semibold")">
                                    <i class="bi bi-@icon me-2"></i>@notif.Title
                                </div>
                                <div class="text-muted mt-1">@notif.Message</div>
                            }
                            <div class="text-muted small mt-2">
                                <i class="bi bi-clock me-1"></i>@notif.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        @if (!notif.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post" class="ms-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@notif.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Đánh dấu đã đọc">
                                    <i class="bi bi-check"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

