@model IEnumerable<BookStore.Models.Notification>
@using BookStore.Helpers
@{
    ViewData["Title"] = "Thông báo";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Thông báo</h2>
        @if (ViewBag.Total > 0)
        {
            <button type="button" id="markAllReadBtn" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-check-all me-1"></i>Đánh dấu tất cả đã đọc
            </button>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-bell-slash text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 mb-2">Không có thông báo nào</h5>
                <p class="text-muted">Bạn chưa có thông báo nào.</p>
            </div>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notif in Model)
            {
                var typeClass = notif.Type == "Success" ? "text-success" : 
                               notif.Type == "Warning" ? "text-warning" : 
                               notif.Type == "Danger" ? "text-danger" : "text-info";
                var icon = notif.Type == "Success" ? "check-circle" : 
                          notif.Type == "Warning" ? "exclamation-triangle" : 
                          notif.Type == "Danger" ? "x-circle" : "info-circle";
                var bgClass = notif.IsRead ? "" : "bg-light";
                var borderClass = notif.IsRead ? "" : "border-start border-3 border-primary";

                <div class="list-group-item @bgClass @borderClass">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(notif.LinkUrl))
                            {
                                <a href="@notif.LinkUrl" class="text-decoration-none text-dark">
                                    <div class="@typeClass @(notif.IsRead ? "" : "fw-semibold")">
                                        <i class="bi bi-@icon me-2"></i>@notif.Title
                                    </div>
                                    <div class="text-muted mt-1">@notif.Message</div>
                                </a>
                            }
                            else
                            {
                                <div class="@typeClass @(notif.IsRead ? "" : "fw-semibold")">
                                    <i class="bi bi-@icon me-2"></i>@notif.Title
                                </div>
                                <div class="text-muted mt-1">@notif.Message</div>
                            }
                            <div class="text-muted small mt-2">
                                <i class="bi bi-clock me-1"></i>@TimeHelper.ToVietnamTime(notif.CreatedAt).ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        @if (!notif.IsRead)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary mark-read-btn" 
                                    data-notification-id="@notif.Id" 
                                    title="Đánh dấu đã đọc">
                                <i class="bi bi-check"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Xử lý đánh dấu từng thông báo đã đọc
            document.querySelectorAll('.mark-read-btn').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const notificationId = this.getAttribute('data-notification-id');
                    const notificationItem = this.closest('.list-group-item');
                    
                    if (!notificationId) return;
                    
                    // Disable button và hiển thị loading
                    this.disabled = true;
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                    
                    try {
                        const formData = new FormData();
                        formData.append('id', notificationId);
                        
                        const response = await fetch('@Url.Action("MarkAsRead", "Notifications")', {
                            method: 'POST',
                            body: formData
                        });
                        
                        if (response.ok) {
                            // Cập nhật UI - ẩn nút và cập nhật style
                            this.remove();
                            notificationItem.classList.remove('bg-light', 'border-start', 'border-3', 'border-primary');
                            const titleElement = notificationItem.querySelector('.fw-semibold');
                            if (titleElement) {
                                titleElement.classList.remove('fw-semibold');
                            }
                        } else {
                            // Khôi phục button nếu có lỗi
                            this.disabled = false;
                            this.innerHTML = originalHtml;
                            alert('Có lỗi xảy ra khi đánh dấu đã đọc.');
                        }
                    } catch (error) {
                        console.error('Error marking notification as read:', error);
                        this.disabled = false;
                        this.innerHTML = originalHtml;
                        alert('Có lỗi xảy ra khi đánh dấu đã đọc.');
                    }
                });
            });

            // Xử lý đánh dấu tất cả đã đọc
            const markAllReadBtn = document.getElementById('markAllReadBtn');
            if (markAllReadBtn) {
                markAllReadBtn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    
                    // Disable button và hiển thị loading
                    this.disabled = true;
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...';
                    
                    try {
                        const response = await fetch('@Url.Action("MarkAllAsRead", "Notifications")', {
                            method: 'POST'
                        });
                        
                        if (response.ok) {
                            // Cập nhật UI - ẩn tất cả nút và cập nhật style
                            document.querySelectorAll('.mark-read-btn').forEach(btn => {
                                btn.remove();
                            });
                            
                            document.querySelectorAll('.list-group-item').forEach(item => {
                                item.classList.remove('bg-light', 'border-start', 'border-3', 'border-primary');
                                const titleElement = item.querySelector('.fw-semibold');
                                if (titleElement) {
                                    titleElement.classList.remove('fw-semibold');
                                }
                            });
                            
                            // Ẩn nút "Đánh dấu tất cả đã đọc"
                            this.style.display = 'none';
                        } else {
                            // Khôi phục button nếu có lỗi
                            this.disabled = false;
                            this.innerHTML = originalHtml;
                            alert('Có lỗi xảy ra khi đánh dấu tất cả đã đọc.');
                        }
                    } catch (error) {
                        console.error('Error marking all as read:', error);
                        this.disabled = false;
                        this.innerHTML = originalHtml;
                        alert('Có lỗi xảy ra khi đánh dấu tất cả đã đọc.');
                    }
                });
            }
        });
    </script>
}

