@model BookStore.Models.ViewModels.BookListVM
@{
    ViewData["Title"] = "Books";
}

<div class="container my-4">

    <!-- Filter bar -->
    <form method="get" class="row g-2 align-items-center mb-3">
        <div class="col-12 col-md-4">
            <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm tên sách, tác giả, ISBN..." />
        </div>

        <div class="col-6 col-md-3">
            <select name="categoryId" class="form-select">
                <option value="">Tất cả thể loại</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id"
                            selected="@(Model.CategoryId == c.Id ? "selected" : null)">
                        @c.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <select name="sort" class="form-select">
                <option value="">Mới nhất</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc"  ? "selected" : null)">Giá ↑</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc" ? "selected" : null)">Giá ↓</option>
                <option value="title_asc" selected="@(Model.Sort == "title_asc"  ? "selected" : null)">Tên A→Z</option>
                <option value="title_desc" selected="@(Model.Sort == "title_desc" ? "selected" : null)">Tên Z→A</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-grid">
            <button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> Lọc</button>
        </div>
    </form>

    @if (!Model.Books.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-emoji-frown" style="font-size:2rem"></i>
            <div class="mt-2">Chưa có sách phù hợp bộ lọc.</div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var b in Model.Books)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                </div>
            }
        </div>

        <!-- Pager -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-sort="@Model.Sort"
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
