@model BookStore.Models.ViewModels.BookListVM
@{
    ViewData["Title"] = "Danh sách Sách";
    string q = Model.Search ?? "";
    string sort = Model.Sort ?? "new";
    int currentPage = Model.Page;
    int totalPages = Model.TotalPages;
    bool hasActiveFilters = !string.IsNullOrEmpty(Model.Search) || 
                          Model.CategoryId.HasValue || 
                          Model.MinPrice.HasValue || 
                          Model.MaxPrice.HasValue || 
                          Model.MinRating.HasValue;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-book me-2"></i>Danh sách Sách
        </h2>
        <p class="text-muted mb-0 small">
            <span id="resultCount">@Model.Books.Count()</span> sách hiển thị · Trang @currentPage/@totalPages
        </p>
    </div>
    @if (hasActiveFilters)
    {
        <a href="@Url.Action("Index")" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-x-circle me-1"></i>Xóa tất cả bộ lọc
        </a>
    }
</div>

<div class="row g-4">
    <!-- Sidebar Filter - Bên trái -->
    <div class="col-12 col-lg-3">
        <form method="get" id="filterForm" class="card shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-funnel-fill me-2"></i>Bộ lọc nâng cao
                </h5>
            </div>
            <div class="card-body">
                <!-- Tìm kiếm -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search me-1"></i>Từ khoá
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input name="search" value="@Model.Search" 
                               class="form-control border-start-0" 
                               placeholder="Tìm tiêu đề, tác giả, mô tả..." 
                               autocomplete="off" />
                    </div>
                    <small class="text-muted">Tìm kiếm trong tiêu đề, tác giả, mô tả và ISBN</small>
                </div>

                <!-- Thể loại -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-tags me-1"></i>Thể loại
                    </label>
                    <select name="categoryId" class="form-select">
                        <option value="">Tất cả thể loại</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">
                                @c.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Khoảng giá -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-currency-dollar me-1"></i>Khoảng giá (₫)
                    </label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="number" 
                                   name="minPrice" 
                                   value="@Model.MinPrice" 
                                   class="form-control form-control-sm" 
                                   placeholder="Từ" 
                                   min="0" 
                                   step="1000" />
                        </div>
                        <div class="col-6">
                            <input type="number" 
                                   name="maxPrice" 
                                   value="@Model.MaxPrice" 
                                   class="form-control form-control-sm" 
                                   placeholder="Đến" 
                                   min="0" 
                                   step="1000" />
                        </div>
                    </div>
                </div>

                <!-- Đánh giá tối thiểu -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-star me-1"></i>Đánh giá tối thiểu
                    </label>
                    <select name="minRating" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="5" selected="@(Model.MinRating == 5)">5 sao</option>
                        <option value="4" selected="@(Model.MinRating == 4)">4 sao trở lên</option>
                        <option value="3" selected="@(Model.MinRating == 3)">3 sao trở lên</option>
                        <option value="2" selected="@(Model.MinRating == 2)">2 sao trở lên</option>
                        <option value="1" selected="@(Model.MinRating == 1)">1 sao trở lên</option>
                    </select>
                </div>

                <!-- Sắp xếp -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-sort-down me-1"></i>Sắp xếp
                    </label>
                    <select name="sort" class="form-select">
                        <option value="new" selected="@(Model.Sort == "new" || string.IsNullOrEmpty(Model.Sort))">Mới nhất</option>
                        <option value="title_asc" selected="@(Model.Sort == "title_asc")">Tên A → Z</option>
                        <option value="title_desc" selected="@(Model.Sort == "title_desc")">Tên Z → A</option>
                        <option value="price_asc" selected="@(Model.Sort == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(Model.Sort == "price_desc")">Giá giảm dần</option>
                        <option value="rating_desc" selected="@(Model.Sort == "rating_desc")">Đánh giá cao nhất</option>
                        <option value="bestseller" selected="@(Model.Sort == "bestseller")">Bán chạy nhất</option>
                    </select>
                </div>

                <!-- Hidden inputs để giữ page khi filter -->
                <input type="hidden" name="page" value="1" />
                
                <button class="btn btn-primary w-100 mb-2" type="submit">
                    <i class="bi bi-funnel me-1"></i>Áp dụng bộ lọc
                </button>
                
                @if (hasActiveFilters)
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Danh sách sách - Bên phải -->
    <div class="col-12 col-lg-9">
        @if (!Model.Books.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-book-x fs-1 text-muted mb-3"></i>
                    <p class="text-muted mb-0">Không tìm thấy sách nào phù hợp</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
                @foreach (var b in Model.Books)
                {
                    <div class="col">
                        <partial name="~/Views/Shared/_BookCard.cshtml" model="b" />
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (totalPages > 1)
{
    <div class="row">
        <div class="col-12 col-lg-9 offset-lg-3">
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-route-search="@Model.Search"
                               asp-route-sort="@sort"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-minRating="@Model.MinRating"
                               asp-route-page="@(currentPage - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }
                    
                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i==currentPage?"active":"")">
                            <a class="page-link"
                               asp-route-search="@Model.Search"
                               asp-route-sort="@sort"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-minRating="@Model.MinRating"
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    
                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-route-search="@Model.Search"
                               asp-route-sort="@sort"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-minRating="@Model.MinRating"
                               asp-route-page="@(currentPage + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}

<style>
    .sticky-top {
        z-index: 1020;
    }
    
    .form-check-input:checked {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }
    
    .card-header.bg-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    }
</style>

@section Scripts {
    <script>
        // Auto-submit khi thay đổi select (trừ price inputs)
        document.querySelectorAll('select[name="categoryId"], select[name="author"], select[name="minRating"], select[name="sort"]').forEach(select => {
            select.addEventListener('change', function() {
                document.getElementById('filterForm').submit();
            });
        });
        
        // Debounce cho search input
        let searchTimeout;
        const searchInput = document.querySelector('input[name="search"]');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                // Không auto-submit, để user tự nhấn nút
            });
        }
    </script>
}