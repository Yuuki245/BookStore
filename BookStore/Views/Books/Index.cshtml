@model BookStore.Models.ViewModels.BookListVM
@{
    ViewData["Title"] = "Books";
}

<h2>Books</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả thể loại --</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm sách / tác giả..." />
    </div>
    <div class="col-auto">
        <select name="sort" class="form-select">
            <option value="">Mới nhất</option>
            <option value="price_asc" selected="@(Model.Sort=="price_asc")">Giá ↑</option>
            <option value="price_desc" selected="@(Model.Sort=="price_desc")">Giá ↓</option>
            <option value="title_asc" selected="@(Model.Sort=="title_asc")">A → Z</option>
            <option value="title_desc" selected="@(Model.Sort=="title_desc")">Z → A</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Lọc</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-4 g-3">
    @foreach (var b in Model.Books)
    {
        <div class="col">
            <div class="card h-100">
                <img class="book-cover" src="@(b.CoverUrl ?? "/images/no-cover.png")" alt="@b.Title" width="300" height="400" loading="lazy"
                     decoding="async"
                     fetchpriority="low">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@b.Title</h5>
                    <p class="text-muted mb-2">@b.Author</p>
                    <div class="mt-auto">
                        <div class="fw-bold">@b.Price.ToString("N0") ₫</div>
                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary mt-2">Details</a>
                        <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@b.Id" />
                            <button class="btn btn-sm btn-primary mt-2">Add to Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i==Model.Page?"active":"")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-search="@Model.Search"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
