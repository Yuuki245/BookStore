@model BookStore.Models.Book
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-4">
        <img class="img-fluid" src="@(Model.CoverUrl ?? "https://via.placeholder.com/300x400")" alt="@Model.Title" />
    </div>
    <div class="col-md-8">
        <h2>@Model.Title</h2>
        <p class="text-muted">@Model.Author</p>
        <p>@Model.Description</p>
        <div class="fs-4 fw-bold mb-3">@Model.Price.ToString("N0") ₫</div>

        <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="number" name="qty" value="1" min="1" class="form-control" style="max-width:120px" />
            <button class="btn btn-primary">Add to Cart</button>
        </form>
    </div>
</div>
