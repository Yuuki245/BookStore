@model BookStore.Models.Book
@{
    ViewData["Title"] = Model.Title;
}
<div class="container my-4">
    <div class="row g-4">
        <div class="col-lg-5">
            <img src="@(Model.CoverUrl ?? "/images/no-cover.png")" class="w-100 rounded shadow-sm" style="object-fit:cover;max-height:520px" />
        </div>
        <div class="col-lg-7">
            <h1 class="mb-1">@Model.Title</h1>
            <div class="text-muted mb-3">Tác giả: @Model.Author</div>
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="condition-badge">Like New</span>
                <span class="book-meta">ISBN: @Model.Isbn</span>
            </div>
            <div class="fs-2 fw-bold text-success mb-3">@($"{Model.Price:N0} ₫")</div>
            <p class="mb-4">@Model.Description</p>
            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model.Id" />
                <button class="btn btn-primary btn-lg"><i class="bi bi-bag-plus"></i> Thêm vào giỏ</button>
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary btn-lg">Tiếp tục xem</a>
            </form>

        </div>
    </div>
</div>
